#!/usr/bin/env bash
# Installs SolidTrace on this machine with Docker Compose, or upgrades it.
#
#   deploy/install                                  # from a clone of the repository
#   git fetch --tags && git checkout <tag> && deploy/install   # to upgrade
#   deploy/install --build                          # build the images from this checkout
#
# Installs Docker if it is missing (Debian and Ubuntu), starts it at boot,
# creates the data directories, EventStore's config, Console's secret and the
# Meta Organization's project key, then
# starts the services, with Caddy in front if deploy/setup-gcp turned HTTPS on.
# It pulls a release's images from GitHub's registry, for amd64 or arm64: the
# release this checkout is at, or on any other commit the newest release before
# it. With --build it builds them from this checkout instead. Safe to run again:
# it never overwrites the config or the secrets. Upgrading from a DuckDB release,
# it first runs the last DuckDB release's prepare-clickhouse with the services
# stopped (prepare_duckdb_logs).

set -euo pipefail

DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Everything the install keeps lives in deploy/, ignored by git: the data,
# EventStore's config, and the secrets in .env.
DATA_DIR="$DEPLOY_DIR/data"
CONFIG_FILE="$DEPLOY_DIR/config/event_store.yml"
ENV_FILE="$DEPLOY_DIR/.env"
# The user Console's image runs as (console/Dockerfile).
CONSOLE_UID=1000
# The user ClickHouse's image runs as.
CLICKHOUSE_UID=101

say() { printf '\n== %s\n' "$*"; }
die() { printf '\nerror: %s\n' "$*" >&2; exit 1; }
as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
compose() { as_root docker compose --project-directory "$DEPLOY_DIR" -f "$DEPLOY_DIR/docker-compose.yml" "$@"; }

install_docker() {
  local packages=()
  command -v curl >/dev/null || packages+=(curl ca-certificates)
  command -v docker >/dev/null || packages+=(docker-ce docker-ce-cli containerd.io)
  as_root docker buildx version >/dev/null 2>&1 || packages+=(docker-buildx-plugin)
  as_root docker compose version >/dev/null 2>&1 || packages+=(docker-compose-plugin)
  (( ${#packages[@]} )) || return 0

  # shellcheck source=/dev/null
  . /etc/os-release
  [[ $ID == ubuntu || $ID == debian ]] ||
    die "Needs Docker with the Compose and Buildx plugins, and curl. This script installs them on Debian and Ubuntu only: https://docs.docker.com/engine/install/"

  say "Installing ${packages[*]}"
  # Docker's apt repository, as in https://docs.docker.com/engine/install/ubuntu/
  as_root apt-get update -qq
  as_root apt-get install -y -qq ca-certificates curl >/dev/null
  as_root install -m 0755 -d /etc/apt/keyrings
  as_root curl -fsSL "https://download.docker.com/linux/$ID/gpg" -o /etc/apt/keyrings/docker.asc
  as_root chmod a+r /etc/apt/keyrings/docker.asc
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/$ID ${UBUNTU_CODENAME:-$VERSION_CODENAME} stable" |
    as_root tee /etc/apt/sources.list.d/docker.list >/dev/null
  as_root apt-get update -qq
  as_root apt-get install -y -qq "${packages[@]}" >/dev/null
}

start_docker() {
  if [[ -d /run/systemd/system ]] && systemctl cat docker.service >/dev/null 2>&1; then
    # At boot too, so the services come back after a reboot.
    as_root systemctl enable --now docker.service
  elif ! as_root docker info >/dev/null 2>&1; then
    # No systemd, as in WSL or a container.
    as_root service docker start
  fi
  for _ in {1..30}; do
    as_root docker info >/dev/null 2>&1 && return
    sleep 1
  done
  die "Docker did not start."
}

# check_old_paths stops an install from before deploy/data, so it doesn't start
# empty beside its old data.
check_old_paths() {
  local old=()
  [[ -e /var/lib/solid-trace ]] && old+=("sudo mv /var/lib/solid-trace $DATA_DIR")
  [[ -e /etc/solid-trace/event_store.yml ]] &&
    old+=("mkdir -p $DEPLOY_DIR/config && sudo mv /etc/solid-trace/event_store.yml $CONFIG_FILE && sudo chown $(id -un): $CONFIG_FILE")
  (( ${#old[@]} )) || return 0
  printf '\nerror: this machine has an install from before its data and config moved\ninto deploy/. Move them there, then run deploy/install again:\n\n' >&2
  printf '  sudo docker compose -f %s/docker-compose.yml down\n' "$DEPLOY_DIR" >&2
  printf '  %s\n' "${old[@]}" >&2
  exit 1
}

create_data_dirs() {
  say "Creating $DATA_DIR"
  as_root install -d -m 0755 -o "$CONSOLE_UID" -g "$CONSOLE_UID" "$DATA_DIR/storage" "$DATA_DIR/storage_cold"
  # ClickHouse's data. Compose stops its image from chowning it.
  as_root install -d -m 0750 -o "$CLICKHOUSE_UID" -g "$CLICKHOUSE_UID" "$DATA_DIR/clickhouse"
  # Caddy's certificates. Its image runs as root.
  as_root install -d -m 0700 "$DATA_DIR/caddy"
}

create_config() {
  if [[ -f $CONFIG_FILE ]]; then
    say "Keeping $CONFIG_FILE"
  else
    say "Writing $CONFIG_FILE"
    install -D -m 0644 "$DEPLOY_DIR/event_store.yml" "$CONFIG_FILE"
  fi
}

# ensure_env_secret NAME BYTES MESSAGE appends NAME, BYTES random bytes in hex,
# to deploy/.env, readable by its owner alone, unless it already has a value.
ensure_env_secret() {
  if grep -qs "^$1=." "$ENV_FILE"; then
    return
  fi
  say "$3"
  (umask 077 && echo "$1=$(od -An -N"$2" -tx1 /dev/urandom | tr -d ' \n')" >>"$ENV_FILE")
}

# ensure_env_value NAME VALUE MESSAGE appends NAME=VALUE to deploy/.env,
# unless it already has a value, which an operator may have changed.
ensure_env_value() {
  if grep -qs "^$1=." "$ENV_FILE"; then
    return
  fi
  say "$3"
  (umask 077 && echo "$1=$2" >>"$ENV_FILE")
}

# env_value KEY prints KEY's value in deploy/.env, or nothing.
env_value() { grep -sE "^$1=" "$ENV_FILE" | tail -n1 | cut -d= -f2- || true; }

https_on() { [[ $(env_value COMPOSE_PROFILES) == *https* ]]; }

# set_env_value NAME VALUE writes NAME=VALUE to deploy/.env, replacing its
# value: for what each run works out afresh.
set_env_value() {
  local tmp
  tmp=$(mktemp)
  grep -svE "^$1=" "$ENV_FILE" > "$tmp" || true
  echo "$1=$2" >> "$tmp"
  # In place, so the file keeps its owner and mode (it holds secrets).
  cat "$tmp" > "$ENV_FILE"
  rm -f "$tmp"
}

# set_version writes SOLIDTRACE_VERSION to deploy/.env: the release whose images
# run, the one this checkout is at or the newest before it, or dev with --build.
set_version() {
  if (( BUILD )); then
    VERSION=dev
  else
    VERSION=$(git -C "$DEPLOY_DIR" describe --tags --abbrev=0 --match 'v*' 2>/dev/null) ||
      die "No release tag before this commit, so no images to pull. Check out a release (git fetch --tags && git checkout <tag>), or build them: deploy/install --build"
    [[ $VERSION == "$(git -C "$DEPLOY_DIR" describe --tags --exact-match 2>/dev/null)" ]] ||
      printf '\nwarning: %s\n' "This commit isn't a release, so it runs $VERSION's images, which may not match this checkout. To run this checkout's code: deploy/install --build" >&2
  fi
  set_env_value SOLIDTRACE_VERSION "$VERSION"
}

# pull_images pulls a release's images, and stops if any isn't there.
pull_images() {
  local image
  # Console's image is listed once for each service that runs it.
  for image in $(compose config --images | sort -u); do
    as_root docker pull --quiet "$image" >/dev/null ||
      die "Couldn't pull $image. Its release may still be building (see https://github.com/Shankar1598/solid_trace/actions), or build from this checkout: deploy/install --build"
  done
}

# config_value KEY prints KEY's value in EventStore's config, if a line sets it.
config_value() { sed -n "s/^$1:[[:space:]]*//p" "$CONFIG_FILE" 2>/dev/null | tail -n1 | tr -d "\"'" || true; }

# host_path PATH prints where PATH, as EventStore's container sees it, is on
# this machine.
host_path() {
  case $1 in
    /storage/*) echo "$DATA_DIR/storage/${1#/storage/}" ;;
    /storage_cold/*) echo "$DATA_DIR/storage_cold/${1#/storage_cold/}" ;;
    *) echo "$1" ;;
  esac
}

# log_file_store prints where the Log file store is, as EventStore's container
# sees it and as EventStore finds it: logs_parquet_path, else logs_parquet
# beside duckdb_path, as the DuckDB releases' config had it.
log_file_store() {
  local files duckdb
  files=$(config_value logs_parquet_path)
  if [[ -z $files ]]; then
    duckdb=$(config_value duckdb_path)
    files="$(dirname "${duckdb:-/storage/duckdb/production/events.duckdb}")/logs_parquet"
  fi
  echo "$files"
}

# set_log_file_store writes SOLIDTRACE_LOG_FILE_STORE to deploy/.env: where the
# Log file store is on this machine, which Compose mounts read-only at
# ClickHouse's user_files_path, /logs_parquet. EventStore's file() reads name
# the files by their path in the store, so ClickHouse finds them there.
set_log_file_store() {
  set_env_value SOLIDTRACE_LOG_FILE_STORE "$(host_path "$(log_file_store)")"
}

# prepare_release prints the newest release before the one to run that ships
# prepare-clickhouse: the last DuckDB release.
prepare_release() {
  local base=HEAD tag
  [[ $VERSION == dev ]] || base="$VERSION^"
  for tag in $(git -C "$DEPLOY_DIR" tag --merged "$base" --sort=-v:refname --list 'v*' 2>/dev/null); do
    if git -C "$DEPLOY_DIR" grep -q prepare-clickhouse "$tag" -- ':/event_store/main.go' 2>/dev/null; then
      echo "$tag"
      return
    fi
  done
  return 1
}

# prepare_duckdb_logs readies the Logs of a DuckDB release for this one. The
# ClickHouse releases read the Log files the DuckDB releases wrote in place,
# from what the last DuckDB release's prepare-clickhouse writes beside
# logs.duckdb, and EventStore won't start on DuckDB data without it. So with
# DuckDB data and no prepare-clickhouse marker, it stops the stack and runs
# that release's command, and stops the install if it fails.
prepare_duckdb_logs() {
  local release=${VERSION}
  # A release from before ClickHouse still runs on DuckDB.
  [[ $release == dev ]] && release=HEAD
  git -C "$DEPLOY_DIR" cat-file -e "$release:deploy/clickhouse" 2>/dev/null || return 0

  # Where EventStore looks for it too: logs_duckdb_path, else beside
  # duckdb_path, else beside the Log file store (logs_parquet_path).
  local logs_duckdb duckdb files prepared
  logs_duckdb=$(config_value logs_duckdb_path)
  if [[ -z $logs_duckdb ]]; then
    duckdb=$(config_value duckdb_path)
    files=$(config_value logs_parquet_path)
    if [[ -n $duckdb ]]; then
      logs_duckdb="$(dirname "$duckdb")/logs.duckdb"
    else
      logs_duckdb="$(dirname "${files:-/storage/duckdb/production/logs_parquet}")/logs.duckdb"
    fi
  fi
  logs_duckdb=$(host_path "$logs_duckdb")
  prepared="$(dirname "$logs_duckdb")/prepared"
  as_root test -e "$logs_duckdb" || return 0
  as_root test -e "$prepared/marker.json" && return 0

  local from image
  from=$(prepare_release) ||
    die "$logs_duckdb holds Logs from a DuckDB release, which $VERSION reads only once the last DuckDB release's prepare-clickhouse has prepared them, and no release before $VERSION ships it. Upgrade to the last DuckDB release first."
  image="ghcr.io/shankar1598/solid-trace-event-store:$from"
  say "Preparing the Logs in $logs_duckdb for ClickHouse with $from's prepare-clickhouse, with the services stopped"
  compose stop ||
    die "Couldn't stop the services. See: sudo docker compose -f $DEPLOY_DIR/docker-compose.yml ps"
  as_root docker pull --quiet "$image" >/dev/null ||
    die "Couldn't pull $image, which prepares the Logs in $logs_duckdb. The services are stopped; run deploy/install again."
  as_root env SOLIDTRACE_VERSION="$from" docker compose --project-directory "$DEPLOY_DIR" -f "$DEPLOY_DIR/docker-compose.yml" \
    run --rm --no-deps event_store ./event_store prepare-clickhouse ||
    die "$from's prepare-clickhouse failed, so the Logs in $logs_duckdb aren't ready for $VERSION. The services are stopped. Fix what it says and run deploy/install again, or go back to $from: git checkout $from && deploy/install"
  as_root test -e "$prepared/marker.json" ||
    die "$from's prepare-clickhouse ended without writing $prepared/marker.json. The services are stopped."
}

start_services() {
  local build=--no-build
  if (( BUILD )); then
    build=--build
    say "Building the images and starting the services"
  else
    say "Pulling SolidTrace $VERSION's images"
    pull_images
    say "Starting the services"
  fi
  compose up --detach "$build" --remove-orphans ||
    die "The services did not start. See: sudo docker compose -f $DEPLOY_DIR/docker-compose.yml logs"
  if https_on; then
    # A changed Caddyfile alone doesn't recreate Caddy.
    compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1 || true
  else
    # Compose leaves a service running when its profile is turned off.
    compose --profile https rm --stop --force caddy >/dev/null 2>&1 || true
  fi
}

# check_https NAME URL records NAME if URL doesn't answer over HTTPS with a
# valid certificate. It connects to this machine, so the firewall isn't in the way.
check_https() {
  local name=$1 url=$2 hostport
  hostport=${url#https://}
  hostport=${hostport%%/*}
  [[ $hostport == *:* ]] || hostport="$hostport:443"
  for _ in {1..30}; do
    curl -fsS -o /dev/null --connect-to "$hostport:127.0.0.1:${hostport##*:}" "$url" 2>/dev/null && return
    sleep 2
  done
  HTTPS_FAILED+=("$name at $url")
}

wait_for() {
  local name=$1 url=$2
  for _ in {1..60}; do
    curl -fsS -o /dev/null "$url" 2>/dev/null && return
    sleep 2
  done
  die "$name did not answer at $url. See: sudo docker compose -f $DEPLOY_DIR/docker-compose.yml logs"
}

check_old_paths
# deploy/setup-gcp runs this check before it asks anything.
[[ ${1:-} == --check-old-paths ]] && exit 0
BUILD=0
[[ ${1:-} == --build ]] && BUILD=1
install_docker
start_docker
create_data_dirs
create_config
ensure_env_secret SECRET_KEY_BASE 64 "Writing Console's secret to $ENV_FILE"
# The project key of the Meta Organization's Project, which receives
# SolidTrace's own Logs (docs/adr/0011). db_prepare gives the Project this key
# when it seeds it, and Vector sends with it.
ensure_env_secret META_PROJECT_KEY 16 "Writing the Meta Organization's project key to $ENV_FILE"
# EventStore's password on ClickHouse, which reads it from the environment too.
ensure_env_secret SOLIDTRACE_CLICKHOUSE_PASSWORD 24 "Writing ClickHouse's password to $ENV_FILE"
# ClickHouse's memory: half of RAM, which leaves Console and Vector the rest.
ensure_env_value SOLIDTRACE_CLICKHOUSE_MEMORY_BYTES \
  "$(awk '/^MemTotal:/ { printf "%.0f", $2 * 1024 / 2 }' /proc/meminfo)" \
  "Giving ClickHouse half of this machine's memory in $ENV_FILE"
set_version
set_log_file_store
prepare_duckdb_logs
start_services
wait_for Console http://127.0.0.1:3000/up
wait_for EventStore http://127.0.0.1:4000/health

host=$(hostname -I 2>/dev/null | awk '{ print $1 }')
console_url="http://${host:-this-machine}:3000"
ingest_url="http://${host:-this-machine}:4000"
HTTPS_FAILED=()
if https_on; then
  public_host=$(env_value PUBLIC_HOST)
  console_url="https://$public_host"
  ingest_url="https://$public_host:4443"
  # The first certificate takes Let's Encrypt a few seconds to a minute.
  check_https Console "$console_url/up"
  check_https Ingest "$ingest_url/health"
fi
# Shippers inside the VPC send to the internal IP on 4000: not through Caddy,
# whose certificate names the public host, nor out through the external IP,
# which GCP bills.
internal_logs_url="http://${host:-this-machine}:4000/api/logs"
public_ingest_url=$(env_value PUBLIC_INGEST_URL)
https_on && public_ingest_url=${public_ingest_url:-$ingest_url}
if [[ -n $public_ingest_url ]]; then
  external_logs_url="$public_ingest_url/api/logs"
else
  external_logs_url="http://<public IP>:4000/api/logs, once the firewall opens port 4000 (or turn HTTPS on in deploy/setup-gcp)"
fi
cat <<EOF

SolidTrace is running, and restarts with the machine.
  Console:  $console_url
  Ingest:   $ingest_url
  Data:     $DATA_DIR
  Config:   $CONFIG_FILE (restart after editing: sudo docker compose -f $DEPLOY_DIR/docker-compose.yml restart event_store)
  Secrets:  $ENV_FILE
  Logs:     SolidTrace's own, in Console's "SolidTrace" Organization and Project,
            whose admin is the first user to sign up. Recent ones also in:
            sudo docker compose -f $DEPLOY_DIR/docker-compose.yml logs -f
  Version:  $VERSION
  Upgrade:  git fetch --tags && git checkout <tag> && deploy/install (main's code: git pull && deploy/install --build)

Shipping Logs to a Project (Vector, Fluent Bit, curl):
  Inside the VPC:  $internal_logs_url
                   Plain HTTP. The firewall must let the VPC reach port 4000, never the internet.
  From outside:    $external_logs_url
  Auth header:     Authorization: Bearer <the Project's key>
  The Project's Logs page has its key and ready-made Vector and Fluent Bit config.
  Sentry SDKs inside the VPC: the Project's DSN with its host swapped for ${host:-this-machine}:4000, over http.
EOF

if (( ${#HTTPS_FAILED[@]} )); then
  printf '\nwarning: no valid certificate yet for:\n' >&2
  printf '  %s\n' "${HTTPS_FAILED[@]}" >&2
  cat >&2 <<EOF
Let's Encrypt must reach $public_host on ports 80 and 443 from the internet.
See why: sudo docker compose -f $DEPLOY_DIR/docker-compose.yml logs caddy
EOF
fi
