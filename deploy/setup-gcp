#!/usr/bin/env bash
#
# A wizard walks a human through a manual procedure, step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library: delightful, consistent UX, identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear wipes the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" shows the opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later, since it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" clears the screen, then announces a stage and shows progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." prints a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." is a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL opens it in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser; visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser, so visit it manually: $url"
}

# pause "msg" waits for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" is a y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY: current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" reads a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" is like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE upserts KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE sets a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name: gh not ready; set it later"
}

# set_var NAME VALUE sets a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name, gh not ready; set it later"
}

# finish clears, then shows a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES: author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

# Configures a SolidTrace install, then runs deploy/install: the public URLs and
# HTTPS, and where EventStore keeps Log files and the Event archive (this
# machine's disk or a GCS bucket). Run it again to change any of them. Email is
# set up in Console, on the Email settings page.
#
#   deploy/setup-gcp

TOTAL_STAGES=9

DEPLOY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$DEPLOY_DIR/.env"
CONFIG_FILE="$DEPLOY_DIR/config/event_store.yml"
SERVICE_ACCOUNT=solid-trace

as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
compose() { as_root docker compose --project-directory "$DEPLOY_DIR" -f "$DEPLOY_DIR/docker-compose.yml" "$@"; }

# ask_default KEY "Prompt" DEFAULT is ask, taking DEFAULT when nothing is typed or saved.
ask_default() {
  if _existing "$1" >/dev/null; then ask "$1" "$2"; else ask "$1" "$2 [$3]"; fi
  [[ -n ${!1} ]] || printf -v "$1" '%s' "$3"
}

# ask_required KEY "Prompt" (secret|plain) asks until something is entered.
ask_required() {
  while :; do
    if [[ ${3:-plain} == secret ]]; then ask_secret "$1" "$2"; else ask "$1" "$2"; fi
    [[ -n ${!1} ]] && return
    warn "This one is needed."
  done
}

# write_env_quoted KEY VALUE writes VALUE in single quotes, so Compose takes it
# as it is: no $ substitution, no # comment. Strips the quotes of a saved value.
write_env_quoted() {
  local value=${2#\'}
  value=${value%\'}
  if [[ $value == *\'* ]]; then
    warn "$1 can't contain a single quote (Compose can't read it). Run deploy/setup-gcp again with another."
    exit 1
  fi
  write_env "$1" "'$value'"
}

# write_config CONTENT replaces the config's content.
write_config() { printf '%s\n' "$1" > "$CONFIG_FILE"; }

# gcp_metadata PATH prints a value from GCP's metadata server, or nothing off GCP.
gcp_metadata() {
  curl -fsS -m 2 -H 'Metadata-Flavor: Google' "http://metadata.google.internal/computeMetadata/v1/$1" 2>/dev/null || true
}

# open_cloud_shell opens Cloud Shell once a run; later stages reuse its tab.
CLOUD_SHELL_OPEN=0
open_cloud_shell() {
  (( CLOUD_SHELL_OPEN )) && return
  open_url "https://shell.cloud.google.com/?show=terminal"
  CLOUD_SHELL_OPEN=1
}

# command_block COMMAND prints a command to copy, in bold.
command_block() { printf '\n%s%s%s\n\n' "$BOLD" "$1" "$RESET"; }

# public_host_problem HOST prints why Let's Encrypt can't give HOST a
# certificate, or nothing. HOST is an IPv4 address or a domain.
public_host_problem() {
  local host=$1 a b
  if [[ $host =~ ^([0-9]{1,3})\.([0-9]{1,3})\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
    if (( a == 10 || a == 127 || a == 0 || (a == 172 && b >= 16 && b <= 31) ||
          (a == 192 && b == 168) || (a == 169 && b == 254) || (a == 100 && b >= 64 && b <= 127) )); then
      echo "$host is a private address. Use the machine's public (external) IP."
    fi
  elif [[ ! $host =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$ ]]; then
    echo "Type an IPv4 address or a domain, with no scheme, port or path."
  elif [[ $host == *.localhost || $host == *.local || $host == *.internal ]]; then
    echo "$host isn't public. Use the machine's public (external) IP."
  fi
}

# The config without the object_store block this wizard writes.
config_without_object_store() {
  awk '/^# Written by deploy\/setup/ { next }
    /^object_store:/ { skip = 1; next }
    skip && /^([[:space:]]|$)/ { next }
    { skip = 0; print }' "$CONFIG_FILE"
}

# An install from before deploy/data must move its data and config first.
"$DEPLOY_DIR/install" --check-old-paths

banner "SolidTrace setup"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Public URLs and HTTPS"
say "Links in Console's emails, and the Logs page's snippets for SDKs, use the"
say "URLs people reach this machine at: its domain or its public IP."
printf '\n'
say "With HTTPS, Caddy gets a certificate from Let's Encrypt for this machine's"
say "public IP or domain: Console on https://<host>, ingest on https://<host>:4443."
note "Ports 80, 443 and 4443 must be reachable from the internet. Without HTTPS,"
note "Console is on http://<host>:3000 and ingest on http://<host>:4000."
printf '\n'
while :; do
  ask_default HTTPS "HTTPS? Type yes or no:" yes
  [[ $HTTPS == yes || $HTTPS == no ]] && break
  warn "Type yes or no."
  HTTPS=""
done
write_env HTTPS "$HTTPS"
printf '\n'
if [[ $HTTPS == yes ]]; then
  external_ip=$(gcp_metadata instance/network-interfaces/0/access-configs/0/external-ip)
  if [[ -n $external_ip ]]; then
    note "GCP says this machine's external IP is $external_ip."
  else
    note "Find this machine's public IP in your cloud's console (on GCP: VM instances → External IP)."
  fi
  while :; do
    if [[ -n $external_ip ]]; then
      ask_default PUBLIC_HOST "Public IP or domain:" "$external_ip"
    else
      ask_required PUBLIC_HOST "Public IP or domain:"
    fi
    problem=$(public_host_problem "$PUBLIC_HOST")
    [[ -z $problem ]] && break
    warn "$problem"
    PUBLIC_HOST=""
  done
  CONSOLE_URL="https://$PUBLIC_HOST"
  PUBLIC_INGEST_URL="https://$PUBLIC_HOST:4443"
  write_env PUBLIC_HOST "$PUBLIC_HOST"
  write_env COMPOSE_PROFILES https
  # Caddy sets X-Forwarded-For, so Console sees each client's IP.
  write_env FORWARD_HEADERS true
else
  # One stage fewer: no firewall rules for HTTPS.
  TOTAL_STAGES=$((TOTAL_STAGES - 1))
  if [[ -n $(_existing PUBLIC_HOST || true) ]]; then
    # The URLs saved with HTTPS on point at Caddy, which won't run now.
    sed -i -E '/^(PUBLIC_HOST|CONSOLE_URL|PUBLIC_INGEST_URL)=/d' "$ENV_FILE"
  fi
  host=$(hostname -I 2>/dev/null | awk '{ print $1 }')
  note "This machine's first address is ${host:-unknown}. On a cloud VM that's the private one."
  while :; do
    ask_default CONSOLE_URL "Console's URL:" "http://${host:-localhost}:3000"
    CONSOLE_URL=${CONSOLE_URL%/}
    [[ $CONSOLE_URL =~ ^https?://[^/]+$ ]] && break
    warn "Use http:// or https:// and a host, with a port if not 80 or 443, and no path."
    CONSOLE_URL=""
  done
  ask PUBLIC_INGEST_URL "Ingest's URL for SDKs (blank: Console's host at port 4000):"
  PUBLIC_INGEST_URL=${PUBLIC_INGEST_URL%/}
  write_env COMPOSE_PROFILES ""
  write_env FORWARD_HEADERS false
fi
write_env CONSOLE_URL "$CONSOLE_URL"
write_env PUBLIC_INGEST_URL "$PUBLIC_INGEST_URL"
pause

if [[ $HTTPS == yes ]]; then
  # ── 2 ───────────────────────────────────────────────────────────────────
  stage "A static IP and the firewall"
  say "The certificate and every DSN name $PUBLIC_HOST, so it mustn't change: an"
  say "ephemeral IP can, when the machine stops. And Let's Encrypt and SDKs must"
  say "reach ports 80, 443 and 4443, while 3000 and 4000 stay closed."
  printf '\n'
  project=$(gcp_metadata project/project-id)
  zone=$(gcp_metadata instance/zone); zone=${zone##*/}
  instance=$(gcp_metadata instance/name)
  network=$(gcp_metadata instance/network-interfaces/0/network); network=${network##*/}
  region=${zone%-*}
  if [[ -z $project ]]; then
    note "Not on GCP, or its metadata server didn't answer: fill in the <...> values,"
    note "or do the same in your cloud's console."
  fi
  # The IP's name if it's already a static address. Empty when it isn't, or when
  # this machine's account can't list addresses, which gcloud doesn't tell apart.
  static_ip=""
  if [[ -n $project && -n $external_ip ]] && command -v gcloud >/dev/null; then
    static_ip=$(timeout 20 gcloud compute addresses list --project="$project" --filter="address=$external_ip" \
      --format='value(name)' --quiet 2>/dev/null | head -n1 || true)
  fi
  open_cloud_shell
  if [[ -n $static_ip ]]; then
    note "$external_ip is already a static address ($static_ip)."
  fi
  step "In Cloud Shell, run these."
  printf '\n%s' "$BOLD"
  if [[ -z $static_ip ]]; then
    # Creates the static address only if the IP isn't one already.
    cat <<EOF
gcloud compute addresses list --project=${project:-<project>} --filter="address=${external_ip:-<external IP>}" --format="value(name)" | grep -q . || gcloud compute addresses create solidtrace-ip --project=${project:-<project>} --region=${region:-<region>} --addresses=${external_ip:-<external IP>}

EOF
  fi
  cat <<EOF
gcloud compute firewall-rules create solidtrace-https --project=${project:-<project>} --network=${network:-default} --allow=tcp:80,tcp:443,tcp:4443 --target-tags=solidtrace

gcloud compute instances add-tags ${instance:-<instance>} --project=${project:-<project>} --zone=${zone:-<zone>} --tags=solidtrace
EOF
  printf '%s\n' "$RESET"
  step "Then delete any rule that opens port 3000 or 4000. To list the rules:"
  printf '\n%s' "$BOLD"
  cat <<EOF
gcloud compute firewall-rules list --project=${project:-<project>} --format="table(name,sourceRanges.list(),allowed[].map().firewall_rule().list())"

gcloud compute firewall-rules delete <name> --project=${project:-<project>}
EOF
  printf '%s\n' "$RESET"
  note "Port 80 serves Let's Encrypt's check and redirects to https://."
  pause "Press Enter once they've run"
fi

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Email"
say "Console emails new Issues, Monitor alerts and invitations through an SMTP"
say "server: your email provider's, or a service such as Amazon SES or Postmark."
say "Set it up in Console once it's running: sign in as the first user, an"
say "instance admin, and open Settings, then Email. It sends a test email too."
if [[ -n $(_existing SMTP_ADDRESS || true) ]]; then
  printf '\n'
  note "Console no longer reads the SMTP_* and MAIL_FROM lines in $ENV_FILE."
  note "Copy them into the Email settings page, then delete them."
fi
pause

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Storage"
say "EventStore keeps each hour's Log files and the Event archive on this"
say "machine's disk. A GCS bucket can hold them instead, for far less than disk;"
say "recent data and the databases stay on disk either way."
note "docs/logs/object-store.md says what goes in the bucket."
printf '\n'
say "  local  This machine's disk"
say "  gcs    A Google Cloud Storage bucket"
printf '\n'
while :; do
  ask STORAGE "Type local or gcs:"
  [[ $STORAGE == local || $STORAGE == gcs ]] && break
  warn "Type local or gcs."
  STORAGE=""
done
write_env STORAGE "$STORAGE"
# Three GCS stages fewer.
[[ $STORAGE == gcs ]] || TOTAL_STAGES=$((TOTAL_STAGES - 3))

if [[ $STORAGE == gcs ]]; then
  # This machine's project and region, when it's on GCP. Stage 2 may have read them.
  [[ -n ${project-} ]] || project=$(gcp_metadata project/project-id)
  if [[ -z ${region-} ]]; then
    zone=$(gcp_metadata instance/zone); zone=${zone##*/}
    region=${zone%-*}
  fi

  # ── 5 ───────────────────────────────────────────────────────────────────
  stage "GCS: the bucket"
  say "EventStore gets a bucket of its own for Log files and the Event archive."
  printf '\n'
  if [[ -n $project ]]; then
    note "GCP says this machine is in project $project."
    ask_default GCP_PROJECT_ID "Google Cloud project ID:" "$project"
  else
    ask_required GCP_PROJECT_ID "Google Cloud project ID:"
  fi
  write_env GCP_PROJECT_ID "$GCP_PROJECT_ID"
  printf '\n'
  bucket_exists=0
  confirm "Have you already created the bucket?" && bucket_exists=1
  while :; do
    ask_required GCS_BUCKET "Bucket name:"
    [[ $GCS_BUCKET =~ ^[a-z0-9][a-z0-9._-]{1,61}[a-z0-9]$ ]] && break
    warn "Bucket names are 3 to 63 lowercase letters, digits, dots, dashes and underscores."
    GCS_BUCKET=""
  done
  write_env GCS_BUCKET "$GCS_BUCKET"
  if (( bucket_exists )); then
    pause
  else
    ask_default GCS_LOCATION "Bucket location, near this machine:" "${region:-us-central1}"
    write_env GCS_LOCATION "$GCS_LOCATION"
    printf '\n'
    open_cloud_shell
    step "In Cloud Shell, create it:"
    command_block "gcloud storage buckets create gs://$GCS_BUCKET --project=$GCP_PROJECT_ID --location=$GCS_LOCATION --uniform-bucket-level-access"
    pause "Press Enter once it's run"
  fi

  # ── 6 ───────────────────────────────────────────────────────────────────
  stage "GCS: the $SERVICE_ACCOUNT service account"
  SERVICE_ACCOUNT_EMAIL=$SERVICE_ACCOUNT@$GCP_PROJECT_ID.iam.gserviceaccount.com
  say "EventStore reaches the bucket as the $SERVICE_ACCOUNT service account, which"
  say "may read, write and delete the bucket's objects."
  printf '\n'
  if ! confirm "Have you already created the $SERVICE_ACCOUNT service account?"; then
    printf '\n'
    open_cloud_shell
    step "In Cloud Shell, create it:"
    command_block "gcloud iam service-accounts create $SERVICE_ACCOUNT --project=$GCP_PROJECT_ID --display-name=SolidTrace"
    pause "Press Enter once it's run"
    printf '\n'
  fi
  open_cloud_shell
  step "In Cloud Shell, let it use gs://$GCS_BUCKET:"
  command_block "gcloud storage buckets add-iam-policy-binding gs://$GCS_BUCKET --member=serviceAccount:$SERVICE_ACCOUNT_EMAIL --role=roles/storage.objectUser"
  pause "Press Enter once it's run"

  # ── 7 ───────────────────────────────────────────────────────────────────
  stage "GCS: the HMAC key"
  say "EventStore reaches GCS through its S3 API, with an HMAC key for $SERVICE_ACCOUNT."
  printf '\n'
  if [[ -n $(_existing SOLIDTRACE_OBJECT_STORE_KEY_ID || true) ]]; then
    note "A key is saved already: press Enter twice to keep it."
  fi
  open_cloud_shell
  step "In Cloud Shell, run:"
  command_block "gcloud storage hmac create $SERVICE_ACCOUNT_EMAIL --project=$GCP_PROJECT_ID"
  step "It prints an accessId and a secret. The secret is shown only once."
  note "Or in the Cloud console: Cloud Storage → Settings → Interoperability →"
  note "Create a key for a service account → $SERVICE_ACCOUNT."
  printf '\n'
  ask_required SOLIDTRACE_OBJECT_STORE_KEY_ID "accessId:"
  ask_required SOLIDTRACE_OBJECT_STORE_SECRET "secret:" secret
  write_env SOLIDTRACE_OBJECT_STORE_KEY_ID "$SOLIDTRACE_OBJECT_STORE_KEY_ID"
  write_env_quoted SOLIDTRACE_OBJECT_STORE_SECRET "$SOLIDTRACE_OBJECT_STORE_SECRET"
  pause
fi

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "EventStore's config"
CONFIG_CHANGED=0
if [[ ! -f $CONFIG_FILE ]]; then
  install -D -m 0644 "$DEPLOY_DIR/event_store.yml" "$CONFIG_FILE"
  note "Created $CONFIG_FILE from deploy/event_store.yml."
fi
if [[ $STORAGE == gcs ]]; then
  block="object_store:
  kind: gcs
  bucket: $GCS_BUCKET"
  say "This block goes at the end of $CONFIG_FILE, in place of any object_store:"
  printf '\n%s' "$BOLD"
  sed 's/^/    /' <<<"$block"
  printf '%s\n' "$RESET"
  note "Its other keys keep their defaults: prefix solidtrace/, local copies kept 24 hours."
  printf '\n'
  if confirm "Write it?"; then
    write_config "$(config_without_object_store)

# Written by deploy/setup-gcp.
$block"
    CONFIG_CHANGED=1
    printf '  %s✓ wrote%s object_store → %s\n' "$GREEN" "$RESET" "$CONFIG_FILE"
  else
    SKIPPED+=("The object_store block in $CONFIG_FILE")
  fi
elif grep -q '^object_store:' "$CONFIG_FILE"; then
  warn "$CONFIG_FILE has an object_store block. Without it, files whose only"
  warn "copy is in the bucket aren't read any more: their Log hours fail and"
  warn "Event reads leave those archived Events out."
  if confirm "Remove it, and keep everything on this machine's disk?"; then
    write_config "$(config_without_object_store)"
    CONFIG_CHANGED=1
    printf '  %s✓ removed%s object_store from %s\n' "$GREEN" "$RESET" "$CONFIG_FILE"
  else
    SKIPPED+=("Removing the object_store block from $CONFIG_FILE")
  fi
else
  say "Nothing to change: $CONFIG_FILE has no bucket."
fi
pause

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "Start SolidTrace"
say "deploy/install installs Docker if it's missing, then pulls the release's"
say "images and starts everything with these settings."
printf '\n'
RUN_INSTALL=0
if confirm "Run deploy/install now?"; then
  RUN_INSTALL=1
else
  SKIPPED+=("Run deploy/install to start SolidTrace with these settings")
fi

finish

if (( RUN_INSTALL )); then
  # A config edit alone doesn't recreate EventStore, so restart it if it was running.
  was_running=$(compose ps -q event_store 2>/dev/null || true)
  "$DEPLOY_DIR/install"
  if [[ -n $was_running ]] && (( CONFIG_CHANGED )); then
    compose restart event_store
  fi
fi

