<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-3xl font-bold tracking-tight"><%= @issue.title %></h2>
      <p class="text-muted-foreground"><%= @issue.culprit %></p>
    </div>
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80">
        <%= @issue.status %>
      </span>
    </div>
  </div>

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Events" } %>
      <% end %>
      <% card.with_content do %>
        <div class="text-2xl font-bold"><%= @issue.events_count %></div>
      <% end %>
    <% end %>
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Users" } %>
      <% end %>
      <% card.with_content do %>
        <div class="text-2xl font-bold"><%= @issue.users_count %></div>
      <% end %>
    <% end %>
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "First Seen" } %>
      <% end %>
      <% card.with_content do %>
        <div class="text-sm font-medium"><%= @issue.created_at.to_fs(:short) %></div>
      <% end %>
    <% end %>
    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Last Seen" } %>
      <% end %>
      <% card.with_content do %>
        <div class="text-sm font-medium"><%= @issue.last_seen_at.to_fs(:short) %></div>
      <% end %>
    <% end %>
  </div>

  <div class="space-y-4">
    <h3 class="text-xl font-semibold">Recent Events</h3>
    <% @events.each do |event| %>
      <%= render Shadcn::CardComponent.new do |card| %>
        <% card.with_header do |header| %>
          <% header.with_title { event.created_at.to_fs(:long) } %>
        <% end %>
        <% card.with_content do %>
          <pre class="bg-muted p-4 rounded-md overflow-x-auto text-xs">
            <code><%= JSON.pretty_generate(event.data) %></code>
          </pre>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
