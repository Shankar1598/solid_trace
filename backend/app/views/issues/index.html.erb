<%
  def level_color(level)
    case level
    when 50 then 'bg-red-500' # Fatal
    when 40 then 'bg-orange-500' # Error
    when 30 then 'bg-yellow-500' # Warning
    when 20 then 'bg-blue-500' # Info
    when 10 then 'bg-gray-400' # Debug
    else 'bg-gray-300'
    end
  end

  def level_label(level)
    case level
    when 50 then 'fatal'
    when 40 then 'error'
    when 30 then 'warning'
    when 20 then 'info'
    when 10 then 'debug'
    else 'unknown'
    end
  end
%>

<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-foreground">Issues</h1>
  </div>

  <!-- Filters Bar -->
  <%= render Shadcn::CardComponent.new do |card| %>
    <% card.with_content do %>
      <div class="flex gap-2">
        <div class="flex-1">
          <%= render Shadcn::InputComponent.new(
            placeholder: "Search by title, message, or tags",
            class: "border-none shadow-none focus-visible:ring-0 bg-transparent"
          ) %>
        </div>
        <div class="flex items-center gap-2 border-l pl-2">
          <%= render Shadcn::SelectComponent.new(name: "status", placeholder: "All Statuses", class: "h-8 w-[130px] border-none shadow-none focus:ring-0") do |select| %>
            <% select.with_item(value: "all") { "All Statuses" } %>
            <% select.with_item(value: "0") { "Unresolved" } %>
            <% select.with_item(value: "1") { "Resolved" } %>
          <% end %>
          <%= render Shadcn::SelectComponent.new(name: "level", placeholder: "All Levels", class: "h-8 w-[110px] border-none shadow-none focus:ring-0") do |select| %>
            <% select.with_item(value: "all") { "All Levels" } %>
            <% select.with_item(value: "50") { "Fatal" } %>
            <% select.with_item(value: "40") { "Error" } %>
            <% select.with_item(value: "30") { "Warning" } %>
            <% select.with_item(value: "20") { "Info" } %>
            <% select.with_item(value: "10") { "Debug" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Issue List -->
  <%= render Shadcn::CardComponent.new do |card| %>
    <% card.with_content do %>
      <div class="overflow-hidden">
        <div class="grid grid-cols-12 gap-4 p-3 border-b bg-muted/30 text-xs font-medium text-muted-foreground uppercase tracking-wider">
          <div class="col-span-6 pl-2">Issue</div>
          <div class="col-span-2 text-center">Graph</div>
          <div class="col-span-1 text-right">Events</div>
          <div class="col-span-1 text-right">Users</div>
          <div class="col-span-2 text-right pr-2">Last Seen</div>
        </div>

        <% if @issues.empty? %>
          <div class="p-12 text-center text-muted-foreground">
            <div class="flex justify-center mb-4">
              <div class="w-12 h-12 rounded-full bg-muted flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
            </div>
            <h3 class="text-lg font-medium text-foreground">No issues found</h3>
            <p class="mt-1">You're doing great!</p>
          </div>
        <% else %>
          <div class="divide-y">
            <% @issues.each do |issue| %>
              <div class="group grid grid-cols-12 gap-4 p-3 items-center hover:bg-muted/30 transition-colors">
                <div class="col-span-6 flex items-start gap-3 pl-2">
                  <%= render Shadcn::CheckboxComponent.new(name: "issue_checkbox", class: "mt-1") %>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-0.5">
                      <span class="w-2 h-2 rounded-sm <%= level_color(issue.level) %>" title="<%= level_label(issue.level) %>"></span>
                      <%= link_to issue.title, issue_path(issue, org_slug: @organization.slug), class: "font-medium text-primary hover:underline truncate block" %>
                    </div>
                    <div class="text-sm text-muted-foreground truncate font-mono">
                      <%= issue.culprit || 'unknown location' %>
                    </div>
                  </div>
                </div>

                <div class="col-span-2 flex justify-center opacity-50">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-4 text-muted-foreground/50"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
                </div>

                <div class="col-span-1 text-right text-sm text-muted-foreground">
                  <%= issue.issue_events.count %>
                </div>

                <div class="col-span-1 text-right text-sm text-muted-foreground">
                  0
                </div>

                <div class="col-span-2 text-right text-sm text-muted-foreground pr-2 flex items-center justify-end gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <%= issue.last_seen_at ? time_ago_in_words(issue.last_seen_at) + " ago" : "never" %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
