<%= render "shared/settings_layout" do %>
  <div class="space-y-6 max-w-2xl mx-auto">
    <div>
      <h3 class="text-lg font-medium">User Settings</h3>
      <p class="text-sm text-muted-foreground">
        Manage your personal account settings.
      </p>
    </div>

    <%= render Shadcn::CardComponent.new do |card| %>
      <% card.with_header do |header| %>
        <% header.with_title { "Profile" } %>
        <% header.with_description { "Your personal information." } %>
      <% end %>
      <% card.with_content do %>
        <%= form_with model: @user, url: edit_user_path(org_slug: current_organization.slug), method: :patch, class: "space-y-4" do |f| %>
          <div class="grid gap-2">
            <%= render Shadcn::LabelComponent.new(for: "user_email") { "Email Address" } %>
            <%= render Shadcn::InputComponent.new(
              name: "user[email]",
              id: "user_email",
              value: @user.email,
              disabled: true,
              class: "bg-muted"
            ) %>
          </div>
          <div class="grid gap-2">
            <%= render Shadcn::LabelComponent.new(for: "user_name") { "Full Name" } %>
            <%= render Shadcn::InputComponent.new(
              name: "user[name]",
              id: "user_name",
              value: @user.name,
              placeholder: "Your Name"
            ) %>
          </div>
          <div class="grid gap-2">
            <%= render Shadcn::LabelComponent.new(for: "user_timezone") { "Timezone" } %>
            <%= render Shadcn::SelectComponent.new(name: "user[timezone]", placeholder: "Select timezone") do |select| %>
              <% select.with_item(value: "utc") { "UTC (Coordinated Universal Time)" } %>
              <% select.with_item(value: "est") { "EST (Eastern Standard Time)" } %>
              <% select.with_item(value: "pst") { "PST (Pacific Standard Time)" } %>
            <% end %>
          </div>
          <div class="flex justify-end">
            <%= render Shadcn::ButtonComponent.new(type: :submit) { "Save Changes" } %>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
