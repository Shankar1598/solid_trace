<div class="space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-3xl font-bold tracking-tight"><%= @project.name %></h2>
      <p class="text-muted-foreground">Key: <%= @project.project_keys.first&.public_key || 'No key' %></p>
    </div>
  </div>

  <div class="rounded-md border">
    <div class="w-full overflow-auto">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b">
          <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Issue</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Events</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Users</th>
            <th class="h-12 px-4 text-left align-middle font-medium text-muted-foreground">Last Seen</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          <% @issues.each do |issue| %>
            <tr class="border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted">
              <td class="p-4 align-middle">
                <%= link_to project_issue_path(@project, issue), class: "font-medium hover:underline" do %>
                  <div class="font-semibold"><%= issue.title %></div>
                  <div class="text-xs text-muted-foreground"><%= issue.culprit %></div>
                <% end %>
              </td>
              <td class="p-4 align-middle"><%= issue.events_count %></td>
              <td class="p-4 align-middle"><%= issue.users_count %></td>
              <td class="p-4 align-middle"><%= time_ago_in_words(issue.last_seen_at) %> ago</td>
            </tr>
          <% end %>
          <% if @issues.empty? %>
            <tr>
              <td colspan="4" class="p-4 text-center text-muted-foreground">No issues found</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
