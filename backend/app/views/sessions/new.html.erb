<div class="flex items-center justify-center min-h-screen bg-muted/50 p-4">
  <%= render Shadcn::CardComponent.new(class: "w-full max-w-md") do |card| %>
    <% card.with_header(class: "p-6") do |header| %>
      <% header.with_title { "Login to Garnet" } %>
      <% header.with_description { "Enter your credentials to access your account" } %>
    <% end %>
    <% card.with_content(class: "p-6 pt-0") do %>
      <%= form_with url: login_path, class: "space-y-4" do |f| %>
        <% if flash[:alert] %>
          <div class="text-sm text-destructive"><%= flash[:alert] %></div>
        <% end %>
        <div class="space-y-2">
          <%= render Shadcn::LabelComponent.new(for: "email") { "Email" } %>
          <%= render Shadcn::InputComponent.new(name: "email", type: "email", required: true) %>
        </div>
        <div class="space-y-2">
          <%= render Shadcn::LabelComponent.new(for: "password") { "Password" } %>
          <%= render Shadcn::InputComponent.new(name: "password", type: "password", required: true) %>
        </div>
        <%= render Shadcn::ButtonComponent.new(type: "submit", class: "w-full") { "Login" } %>
        <div class="text-center text-sm text-muted-foreground">
          Don't have an account? <%= link_to "Register", signup_path, class: "text-primary hover:underline" %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
