<div class="w-full md:w-64 flex-shrink-0">
  <div class="sticky top-6">
    <h2 class="text-lg font-semibold mb-4 px-3 text-gray-900 dark:text-white">Settings</h2>
    <nav class="space-y-1">
      <%= link_to settings_path(org_slug: @current_org.slug), class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'organization_settings' ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        Organization
      <% end %>

      <%= link_to org_user_settings_path(org_slug: @current_org.slug), class: "flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium transition-colors #{controller_name == 'user_settings' ? 'bg-gray-100 text-gray-900 dark:bg-gray-800 dark:text-white' : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-800'}" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
        User
      <% end %>
    </nav>
  </div>
</div>
