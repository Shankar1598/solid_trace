<h1>New Issue Detected</h1>

<p><strong>Project:</strong> <%= @project.name %></p>
<p><strong>Kind:</strong> <%= @issue.kind %></p>
<p><strong>Title:</strong> <%= @issue.title %></p>

<p>
  <%= link_to "View Issue", project_issue_url(@project, @issue, org_slug: @project.organization.slug, host: Garnet::Application.config.action_mailer.default_url_options[:host] || "localhost:3000") %>
</p>
