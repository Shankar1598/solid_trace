<div class="flex gap-3 py-4 border-b border-gray-200 dark:border-gray-700" id="<%= dom_id(comment) %>">
  <div class="flex-shrink-0">
    <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center text-sm font-medium text-gray-600 dark:bg-gray-700 dark:text-gray-300">
      <%= comment.user&.name&.first&.upcase || "?" %>
    </div>
  </div>
  <div class="flex-grow space-y-1">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2 text-sm">
        <span class="font-medium text-gray-900 dark:text-white"><%= comment.user&.name || "Unknown User" %></span>
        <span class="text-gray-500 dark:text-gray-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
      </div>
      <% if comment.user == Current.user %>
        <%= button_to issue_comment_path(comment.issue, comment, org_slug: comment.issue.project.organization.slug),
                      method: :delete,
                      form: { data: { turbo_confirm: "Are you sure you want to delete this comment?" } },
                      class: "text-gray-400 hover:text-red-500 dark:text-gray-500 dark:hover:text-red-400 transition-colors p-1" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      <% end %>
    </div>
    <div class="prose prose-sm dark:prose-invert max-w-none text-gray-700 dark:text-gray-300">
      <%= comment.content %>
    </div>
  </div>
</div>
