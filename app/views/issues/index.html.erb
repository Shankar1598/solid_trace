<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-white">Issues</h1>
  </div>

  <!-- Filters Bar -->
  <div class="flex gap-2 p-2 bg-white border border-gray-200 rounded-md shadow-sm dark:bg-gray-800 dark:border-gray-700">
    <%= form_with url: issues_path(org_slug: @current_org.slug), method: :get, class: "flex w-full gap-2", data: { turbo_frame: "issues_list", turbo_action: "advance" } do |form| %>
      <div class="flex-1">
        <%= form.text_field :query, value: params[:query], placeholder: "Search by title, message, or tags", class: "w-full border-none shadow-none focus:ring-0 bg-transparent text-sm text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400" %>
      </div>
      <div class="flex items-center gap-2 border-l border-gray-200 pl-2 dark:border-gray-700">
        <%= form.select :status, options_for_select([['All Statuses', 'all'], ['Unresolved', '0'], ['Resolved', '1']], params[:status] || '0'), {}, { onchange: "this.form.requestSubmit()", class: "w-[130px] border-none shadow-none focus:ring-0 h-8 text-sm bg-transparent text-gray-900 dark:text-white" } %>
        <%= form.select :level, options_for_select([['All Levels', 'all'], ['Fatal', '50'], ['Error', '40'], ['Warning', '30'], ['Info', '20'], ['Debug', '10']], params[:level] || 'all'), {}, { onchange: "this.form.requestSubmit()", class: "w-[110px] border-none shadow-none focus:ring-0 h-8 text-sm bg-transparent text-gray-900 dark:text-white" } %>
      </div>
    <% end %>
  </div>

  <!-- Issue List -->
  <div class="bg-white border border-gray-200 rounded-md shadow-sm overflow-hidden dark:bg-gray-800 dark:border-gray-700">
    <div class="grid grid-cols-12 gap-4 p-3 border-b border-gray-200 bg-gray-50 text-xs font-medium text-gray-500 uppercase tracking-wider dark:bg-gray-700 dark:border-gray-600 dark:text-gray-400">
      <div class="col-span-6 pl-2">Issue</div>
      <div class="col-span-2 text-center">Graph</div>
      <div class="col-span-1 text-right">Events</div>
      <div class="col-span-1 text-right">Users</div>
      <div class="col-span-2 text-right pr-2">Last Seen</div>
    </div>

    <%= turbo_frame_tag "issues_list" do %>
      <% if @issues.empty? %>
        <div class="p-12 text-center text-gray-500 dark:text-gray-400">
          <div class="flex justify-center mb-4">
            <div class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center dark:bg-gray-700">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
          </div>
          <h3 class="text-lg font-medium text-gray-900 dark:text-white">No issues found</h3>
          <p class="mt-1">You're doing great!</p>
        </div>
      <% else %>
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @issues.each do |issue| %>
            <div class="group grid grid-cols-12 gap-4 p-3 items-center hover:bg-gray-50 transition-colors dark:hover:bg-gray-700/50">
              <div class="col-span-6 flex items-start gap-3 pl-2">
                <input type="checkbox" class="mt-1 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-700 dark:ring-offset-gray-800">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-0.5">
                    <span class="w-2 h-2 rounded-sm <%= level_color(issue.level) %>" title="<%= level_label(issue.level) %>"></span>
                    <%= link_to issue.title, issue_path(issue, org_slug: @current_org.slug), class: "font-medium text-blue-600 hover:underline truncate block dark:text-blue-400", data: { turbo_frame: "_top" } %>
                  </div>
                  <div class="text-sm text-gray-500 truncate font-mono dark:text-gray-400">
                    <%= issue.culprit || 'unknown location' %>
                  </div>
                </div>
              </div>

              <div class="col-span-2 flex justify-center opacity-50">
                <!-- Sparkline Placeholder -->
                <svg class="w-8 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 12"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M0 10 L4 8 L8 11 L12 5 L16 7 L20 3 L24 6"></path></svg>
              </div>

              <div class="col-span-1 text-right text-sm text-gray-500 dark:text-gray-400">
                <%= issue.issue_events.count %>
              </div>

              <div class="col-span-1 text-right text-sm text-gray-500 dark:text-gray-400">
                0
              </div>

              <div class="col-span-2 text-right text-sm text-gray-500 pr-2 flex items-center justify-end gap-1 dark:text-gray-400">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <%= time_ago_in_words(issue.updated_at) %> ago
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
