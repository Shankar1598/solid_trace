<div class="space-y-6">
  <!-- Header -->
  <div class="space-y-4">
    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <%= link_to issues_path(org_slug: @current_org.slug), class: "hover:text-gray-900 dark:hover:text-white flex items-center gap-1" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Issues
      <% end %>
      <span>/</span>
      <span class="font-mono text-xs">#<%= @issue.id %></span>
    </div>

    <div class="flex justify-between items-start">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
          <%= @issue.title %>
        </h1>
        <p class="text-gray-500 font-mono text-sm dark:text-gray-400">
          <%= @issue.culprit || 'unknown location' %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <%= form_with url: issue_path(@issue, org_slug: @current_org.slug), method: :get, class: "flex items-center", data: { turbo_action: "replace" } do |form| %>
          <%= form.select :environment, options_for_select([['All Envs', 'all']] + @environments.map { |e| [e, e] }, params[:environment] || 'all'), {}, { onchange: "this.form.requestSubmit()", class: "w-[110px] border-gray-300 rounded-md shadow-sm focus:border-primary-500 focus:ring-primary-500 text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white py-1" } %>
        <% end %>
        <button class="btn-secondary btn-xs flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
          Share
        </button>
        <% if @issue.status == 0 %>
          <%= button_to resolve_issue_path(@issue, org_slug: @current_org.slug), method: :patch, class: "btn-primary btn-xs" do %>
            Resolve
          <% end %>
        <% else %>
          <%= button_to unresolve_issue_path(@issue, org_slug: @current_org.slug), method: :patch, class: "btn-secondary btn-xs" do %>
            Unresolve
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="flex items-center gap-8 py-3 border-y border-gray-200 bg-gray-50 px-4 rounded-sm text-sm dark:bg-gray-800 dark:border-gray-700">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        <span class="font-medium text-gray-900 dark:text-white"><%= @issue.events.count %></span>
        <span class="text-gray-500 dark:text-gray-400">Events</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <span class="font-medium text-gray-900 dark:text-white">1</span>
        <span class="text-gray-500 dark:text-gray-400">Users</span>
      </div>
      <div class="flex items-center gap-2 ml-auto text-gray-500 dark:text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>First seen <%= @issue.created_at.strftime("%b %d") %></span>
        <span>•</span>
        <span>Last seen <%= @issue.updated_at.strftime("%b %d") %></span>
      </div>
    </div>
  </div>

  <!-- Event Navigation -->
  <% if @event %>
    <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-700 mb-4">
       <div class="text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
         <span class="font-mono">Event ID: <%= @event.id %></span>
         <span class="mx-1">•</span>
         <span><%= @event.created_at.to_fs(:long) %></span>
       </div>
       <div class="flex items-center gap-2">
         <!-- Older -->
         <% if @prev_event %>
           <%= link_to issue_path(@issue, event_id: @prev_event.id, environment: params[:environment], org_slug: @current_org.slug), class: "btn-secondary btn-xs flex items-center gap-1", data: { key: "ArrowLeft" } do %>
             <span>&larr;</span> Older
           <% end %>
         <% else %>
           <button class="btn-secondary btn-xs opacity-50 cursor-not-allowed flex items-center gap-1" disabled><span>&larr;</span> Older</button>
         <% end %>

         <!-- Newer -->
         <% if @next_event %>
           <%= link_to issue_path(@issue, event_id: @next_event.id, environment: params[:environment], org_slug: @current_org.slug), class: "btn-secondary btn-xs flex items-center gap-1", data: { key: "ArrowRight" } do %>
             Newer <span>&rarr;</span>
           <% end %>
         <% else %>
           <button class="btn-secondary btn-xs opacity-50 cursor-not-allowed flex items-center gap-1" disabled>Newer <span>&rarr;</span></button>
         <% end %>
       </div>
    </div>
  <% end %>

  <!-- Main Content -->
  <div class="mb-4 border-b border-gray-200 dark:border-gray-700">
    <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="issueTab" data-tabs-toggle="#issueTabContent" role="tablist">
      <li class="mr-2" role="presentation">
        <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300 text-gray-500 dark:text-gray-400 aria-selected:text-gray-600 dark:aria-selected:text-gray-300" id="overview-tab" data-tabs-target="#overview" type="button" role="tab" aria-controls="overview" aria-selected="false">Overview</button>
      </li>
      <li class="mr-2" role="presentation">
        <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300 text-gray-500 dark:text-gray-400 aria-selected:text-gray-600 dark:aria-selected:text-gray-300" id="json-tab" data-tabs-target="#json" type="button" role="tab" aria-controls="json" aria-selected="false">JSON</button>
      </li>
      <li class="mr-2" role="presentation">
        <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300 text-gray-500 dark:text-gray-400 aria-selected:text-gray-600 dark:aria-selected:text-gray-300" id="comments-tab" data-tabs-target="#comments" type="button" role="tab" aria-controls="comments" aria-selected="false">Comments</button>
      </li>
    </ul>
  </div>

  <div id="issueTabContent">
    <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="overview" role="tabpanel" aria-labelledby="overview-tab">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column -->
        <div class="lg:col-span-2 space-y-8">
          <% if @event %>
            <% if @event.event_data['exception'] %>
              <div class="space-y-3">
                <h3 class="text-lg font-semibold flex items-center gap-2 text-gray-900 dark:text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
                  Exception
                </h3>
                <div class="border border-gray-200 rounded-md overflow-hidden dark:border-gray-700">
                  <%= render "stacktrace", exception: @event.event_data['exception'] %>
                </div>
              </div>
            <% end %>

            <% if @event.event_data['breadcrumbs'] %>
              <div class="space-y-3">
                <h3 class="text-lg font-semibold flex items-center gap-2 text-gray-900 dark:text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                  Breadcrumbs
                </h3>
                <div class="border border-gray-200 rounded-md overflow-hidden bg-white dark:bg-gray-900 dark:border-gray-700">
                  <%= render "breadcrumbs", breadcrumbs: @event.event_data['breadcrumbs'] %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-500 dark:text-gray-400">No events found for this issue.</p>
          <% end %>
        </div>

        <!-- Right Column -->
        <div class="space-y-6">
          <% if @event %>
            <!-- Environment -->
            <div class="space-y-3">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Environment</h3>
              <div class="font-mono text-sm text-gray-900 dark:text-white">
                <%= @event.environment || 'unknown' %>
              </div>
            </div>
            <hr class="border-gray-200 dark:border-gray-700">

            <!-- Tags -->
            <% if @event.event_data['tags'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Tags</h3>
                <div class="space-y-2">
                  <% @event.event_data['tags'].each do |key, value| %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400"><%= key %></span>
                      <span class="font-mono text-gray-900 bg-gray-100 px-1.5 py-0.5 rounded text-xs truncate max-w-[150px] dark:bg-gray-700 dark:text-white" title="<%= value %>">
                        <%= value %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <hr class="border-gray-200 dark:border-gray-700">

            <!-- User Context -->
            <% if @event.event_data['user'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">User</h3>
                <div class="space-y-2">
                  <% @event.event_data['user'].each do |key, value| %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400"><%= key %></span>
                      <span class="font-mono text-gray-900 text-xs truncate max-w-[150px] dark:text-white">
                        <%= value %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <hr class="border-gray-200 dark:border-gray-700">

            <!-- Request Context -->
            <% if @event.event_data['request'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Request</h3>
                <div class="space-y-2">
                  <% if @event.event_data['request']['url'] %>
                    <div class="space-y-1">
                      <span class="text-xs text-gray-500 dark:text-gray-400">URL</span>
                      <div class="font-mono text-xs break-all bg-gray-100 p-1 rounded dark:bg-gray-700 dark:text-white"><%= @event.event_data['request']['url'] %></div>
                    </div>
                  <% end %>
                  <% if @event.event_data['request']['method'] %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Method</span>
                      <span class="font-mono text-gray-900 text-xs dark:text-white"><%= @event.event_data['request']['method'] %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="json" role="tabpanel" aria-labelledby="json-tab">
      <div class="rounded-md border border-gray-200 bg-gray-100 p-4 overflow-auto dark:bg-gray-900 dark:border-gray-700">
        <pre class="text-sm font-mono whitespace-pre-wrap break-all text-gray-900 dark:text-white"><%= @event ? JSON.pretty_generate(@event.event_data) : 'No event data available' %></pre>
      </div>
    </div>

    <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="comments" role="tabpanel" aria-labelledby="comments-tab">
      <div class="space-y-8 max-w-4xl">
        <div class="space-y-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Comments (<span id="comments-count"><%= @issue.comments.count %></span>)</h3>
          <div id="comments-list" class="space-y-4">
            <% if @issue.comments.any? %>
              <%= render @issue.comments.includes(:user).order(created_at: :asc) %>
            <% else %>
              <div id="no-comments" class="text-center py-8 bg-gray-100 rounded-lg border border-dashed border-gray-300 dark:bg-gray-700 dark:border-gray-600">
                <p class="text-gray-500 dark:text-gray-400">No comments yet.</p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="pt-6 border-t border-gray-200 dark:border-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Add a comment</h3>
          <div id="comment-flash" class="mb-4"></div>
          <%= render "comments/form" %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('keydown', function(e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

    if (e.key === 'ArrowLeft') {
      const link = document.querySelector('[data-key="ArrowLeft"]');
      if (link) link.click();
    } else if (e.key === 'ArrowRight') {
      const link = document.querySelector('[data-key="ArrowRight"]');
      if (link) link.click();
    }
  });

  // Handle URL hash to open specific tabs (e.g., #comments, #json, #overview)
  function activateTabFromHash() {
    const hash = window.location.hash.slice(1); // Remove the # symbol
    if (hash) {
      // Small delay to ensure Flowbite has initialized the tabs
      setTimeout(function() {
        const tabButton = document.getElementById(hash + '-tab');
        if (tabButton) {
          tabButton.click();
        }
      }, 100);
    }
  }

  // Update URL hash when tabs are clicked
  function setupTabHashUpdates() {
    const tabButtons = document.querySelectorAll('#issueTab button[role="tab"]');
    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        const tabId = this.getAttribute('aria-controls');
        if (tabId) {
          history.replaceState(null, null, '#' + tabId);
        }
      });
    });
  }

  // Activate tab on page load
  document.addEventListener('turbo:load', function() {
    setupTabHashUpdates();
    activateTabFromHash();
  });
  document.addEventListener('DOMContentLoaded', function() {
    setupTabHashUpdates();
    activateTabFromHash();
  });

  // Activate tab when hash changes
  window.addEventListener('hashchange', activateTabFromHash);
</script>
