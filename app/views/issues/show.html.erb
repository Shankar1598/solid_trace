<div class="space-y-6">
  <!-- Header -->
  <div class="space-y-4">
    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <%= link_to issues_path(org_slug: @current_org.slug), class: "hover:text-gray-900 dark:hover:text-white flex items-center gap-1" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Issues
      <% end %>
      <span>/</span>
      <span class="font-mono text-xs">#<%= @issue.id %></span>
    </div>

    <div class="flex justify-between items-start">
      <div class="space-y-1">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white flex items-center gap-3">
          <span class="text-xs uppercase px-1.5 py-0.5 border rounded font-mono <%= level_color(@issue.level).gsub('bg-', 'text-').gsub('500', '600') %> border-current">
            <%= level_label(@issue.level) %>
          </span>
          <%= @issue.title %>
        </h1>
        <p class="text-gray-500 font-mono text-sm dark:text-gray-400">
          <%= @issue.culprit || 'unknown location' %>
        </p>
      </div>
      <div class="flex items-center gap-2">
        <button class="btn-secondary btn-xs flex items-center gap-2">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path></svg>
          Share
        </button>
        <% if @issue.status == 0 %>
          <%= button_to resolve_issue_path(@issue, org_slug: @current_org.slug), method: :patch, class: "btn-primary btn-xs" do %>
            Resolve
          <% end %>
        <% else %>
          <%= button_to unresolve_issue_path(@issue, org_slug: @current_org.slug), method: :patch, class: "btn-secondary btn-xs" do %>
            Unresolve
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="flex items-center gap-8 py-3 border-y border-gray-200 bg-gray-50 px-4 rounded-sm text-sm dark:bg-gray-800 dark:border-gray-700">
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        <span class="font-medium text-gray-900 dark:text-white"><%= @issue.issue_events.count %></span>
        <span class="text-gray-500 dark:text-gray-400">Events</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        <span class="font-medium text-gray-900 dark:text-white">1</span>
        <span class="text-gray-500 dark:text-gray-400">Users</span>
      </div>
      <div class="flex items-center gap-2 ml-auto text-gray-500 dark:text-gray-400">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>First seen <%= @issue.created_at.strftime("%b %d") %></span>
        <span>•</span>
        <span>Last seen <%= @issue.updated_at.strftime("%b %d") %></span>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="mb-4 border-b border-gray-200 dark:border-gray-700">
    <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="issueTab" data-tabs-toggle="#issueTabContent" role="tablist">
      <li class="mr-2" role="presentation">
        <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300 text-gray-500 dark:text-gray-400" id="overview-tab" data-tabs-target="#overview" type="button" role="tab" aria-controls="overview" aria-selected="false">Overview</button>
      </li>
      <li class="mr-2" role="presentation">
        <button class="inline-block p-4 border-b-2 border-transparent rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300 text-gray-500 dark:text-gray-400" id="json-tab" data-tabs-target="#json" type="button" role="tab" aria-controls="json" aria-selected="false">JSON</button>
      </li>
    </ul>
  </div>

  <div id="issueTabContent">
    <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="overview" role="tabpanel" aria-labelledby="overview-tab">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left Column -->
        <div class="lg:col-span-2 space-y-8">
          <% if @latest_event %>
            <% if @latest_event.data['exception'] %>
              <div class="space-y-3">
                <h3 class="text-lg font-semibold flex items-center gap-2 text-gray-900 dark:text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path></svg>
                  Exception
                </h3>
                <div class="border border-gray-200 rounded-md overflow-hidden dark:border-gray-700">
                  <%= render "stacktrace", exception: @latest_event.data['exception'] %>
                </div>
              </div>
            <% end %>

            <% if @latest_event.data['breadcrumbs'] %>
              <div class="space-y-3">
                <h3 class="text-lg font-semibold flex items-center gap-2 text-gray-900 dark:text-white">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                  Breadcrumbs
                </h3>
                <div class="border border-gray-200 rounded-md overflow-hidden bg-white dark:bg-gray-900 dark:border-gray-700">
                  <%= render "breadcrumbs", breadcrumbs: @latest_event.data['breadcrumbs'] %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-gray-500 dark:text-gray-400">No events found for this issue.</p>
          <% end %>
        </div>

        <!-- Right Column -->
        <div class="space-y-6">
          <% if @latest_event %>
            <!-- Tags -->
            <% if @latest_event.data['tags'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Tags</h3>
                <div class="space-y-2">
                  <% @latest_event.data['tags'].each do |key, value| %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400"><%= key %></span>
                      <span class="font-mono text-gray-900 bg-gray-100 px-1.5 py-0.5 rounded text-xs truncate max-w-[150px] dark:bg-gray-700 dark:text-white" title="<%= value %>">
                        <%= value %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <hr class="border-gray-200 dark:border-gray-700">

            <!-- User Context -->
            <% if @latest_event.data['user'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">User</h3>
                <div class="space-y-2">
                  <% @latest_event.data['user'].each do |key, value| %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400"><%= key %></span>
                      <span class="font-mono text-gray-900 text-xs truncate max-w-[150px] dark:text-white">
                        <%= value %>
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <hr class="border-gray-200 dark:border-gray-700">

            <!-- Request Context -->
            <% if @latest_event.data['request'].present? %>
              <div class="space-y-3">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Request</h3>
                <div class="space-y-2">
                  <% if @latest_event.data['request']['url'] %>
                    <div class="space-y-1">
                      <span class="text-xs text-gray-500 dark:text-gray-400">URL</span>
                      <div class="font-mono text-xs break-all bg-gray-100 p-1 rounded dark:bg-gray-700 dark:text-white"><%= @latest_event.data['request']['url'] %></div>
                    </div>
                  <% end %>
                  <% if @latest_event.data['request']['method'] %>
                    <div class="flex justify-between items-center text-sm">
                      <span class="text-gray-500 dark:text-gray-400">Method</span>
                      <span class="font-mono text-gray-900 text-xs dark:text-white"><%= @latest_event.data['request']['method'] %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
    <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="json" role="tabpanel" aria-labelledby="json-tab">
      <div class="rounded-md border border-gray-200 bg-gray-100 p-4 overflow-auto dark:bg-gray-900 dark:border-gray-700">
        <pre class="text-sm font-mono whitespace-pre-wrap break-all text-gray-900 dark:text-white"><%= @latest_event ? JSON.pretty_generate(@latest_event.data) : 'No event data available' %></pre>
      </div>
    </div>
  </div>
</div>
