#!/usr/bin/env bash
# Builds the solidtrace binary with no cgo for each OS and architecture
# that the releases give: Linux and macOS, amd64 and arm64. The binaries go
# to cli/dist/solidtrace-<os>-<arch>.
#
#   cli/build [version]     (version: v0.19.0; default dev)
set -euo pipefail

cd "$(dirname "$0")"
version="${1:-dev}"
mkdir -p dist
for os in linux darwin; do
  for arch in amd64 arm64; do
    CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath \
      -ldflags "-s -w -X github.com/solidtrace/cli/version.Version=$version" \
      -o "dist/solidtrace-$os-$arch" ./cmd/solidtrace
    echo "dist/solidtrace-$os-$arch"
  done
done
