#!/usr/bin/env sh
# Builds the VRL staticlib that the vrl package links, for this machine.
# Run it from anywhere before go build or go test in event_store/, and
# again after changing vrl/rust/. Cargo honours CARGO_TARGET_DIR and
# CARGO_BUILD_JOBS.
set -eu
cd "$(dirname "$0")"

cargo build --release --locked --manifest-path rust/Cargo.toml
target_dir=$(cargo metadata --format-version 1 --no-deps --manifest-path rust/Cargo.toml |
	sed 's/.*"target_directory":"\([^"]*\)".*/\1/')
lib="lib/$(go env GOOS)_$(go env GOARCH)"
mkdir -p "$lib"
cp "$target_dir/release/libst_vrl.a" "$lib/libst_vrl.a"

# Go's build cache keys cgo on the LDFLAGS text, not the library, so a
# rebuilt library would otherwise be ignored. This file changes with it.
hash=$(sha256sum "$lib/libst_vrl.a" | cut -d' ' -f1)
printf '// Code generated by vrl/build. DO NOT EDIT.\n\npackage vrl\n\nconst _ = "%s"\n' "$hash" >libhash_gen.go
