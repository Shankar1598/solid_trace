<h1>Issue Assignment Updated</h1>

<p><strong>Project:</strong> <%= @project.name %></p>
<p><strong>Issue:</strong> #<%= @issue.number %> <%= @issue.title %></p>
<p><strong>From:</strong> <%= @previous_assignee_name %></p>
<p><strong>To:</strong> <%= @new_assignee_name %></p>

<p>
  <%= link_to "View Issue", project_issue_url(@project, @issue, org_slug: @project.organization.slug, host: SolidTrace::Application.config.action_mailer.default_url_options[:host] || "localhost:3000") %>
</p>

