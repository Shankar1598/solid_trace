<h1>Welcome to SolidTrace!</h1>

<p>Hi <%= @user.name %>,</p>

<p>
  <strong><%= @invited_by.name %></strong> has invited you to the
  <strong><%= @organization.name %></strong> organization on SolidTrace.
</p>

<p>
  <%= link_to "Set your password and sign in", @invite_url %>
</p>

<p>
  The link works once, for seven days. If it has expired, ask an admin of <%= @organization.name %> for a new one.
</p>

<hr>

<p>
  <small>If you didn't expect this invitation, please ignore this email or contact support.</small>
</p>
