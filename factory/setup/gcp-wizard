# ── 15 ────────────────────────────────────────────────────────────────────
if begin "Your machine: the solidtrace CLI and the tunnel to the Dispatcher"; then
  need PROJECT SERVER_VM SERVER_ZONE SOLIDTRACE_URL RELEASE
  if ! command -v solidtrace >/dev/null 2>&1; then
    run_cmd "Install the solidtrace CLI of the release (in ~/.local/bin)" \
      "curl -fsSL https://github.com/$RELEASE_REPO/releases/download/$RELEASE/install.sh | sh"
  fi
  run_cmd "Look at the CLI's version (the same release as the Dispatcher, or at most three minor releases older)" \
    "solidtrace --version"
  run_cmd "Sign in to SolidTrace (it opens your browser)" "solidtrace login $SOLIDTRACE_URL"
  ask_default LOCAL_PORT "The local port for the tunnel to the Dispatcher:" 7600
  remember LOCAL_PORT
  say "The Dispatcher's API is never public. Your machine reaches it through an IAP tunnel,"
  say "which runs in the background until the end of this wizard."
  run_cmd "Open the tunnel, and call the Dispatcher's status through it" \
    "gcloud compute start-iap-tunnel $SERVER_VM 7600 --local-host-port=localhost:$LOCAL_PORT --zone $SERVER_ZONE --project $PROJECT \\
    >$STATE_DIR/tunnel.log 2>&1 &
echo \$! >$STATE_DIR/tunnel.pid
sleep 5
curl -fsS http://localhost:$LOCAL_PORT/api/v1/status; echo"
  note "Later: the same gcloud command, without the '&', opens the tunnel again for the solidtrace verbs."
fi

# ── 16 ────────────────────────────────────────────────────────────────────
if begin "Bitbucket: a test repository and its token"; then
  need LOCAL_PORT
  say "A small private repository for the first Run, so that no real code changes."
  ask BB_WORKSPACE "Your Bitbucket workspace:"
  ask_default BB_REPO "The test repository's name:" factory-pilot
  remember BB_WORKSPACE BB_REPO
  open_url "https://bitbucket.org/repo/create"
  step "Workspace $BB_WORKSPACE, name $BB_REPO, Private, Include a README: Yes, default branch main."
  pause "Press Enter when the repository exists."
  say "The factory file gives the Run one check: README.md has the pilot's line."
  run_cmd "Add .solidtrace/factory.toml to the repository (with your own git login)" \
    "d=\$(mktemp -d) && git clone -q https://bitbucket.org/$BB_WORKSPACE/$BB_REPO.git \"\$d\" && cd \"\$d\" &&
mkdir -p .solidtrace && cat >.solidtrace/factory.toml <<'TOML'
# The factory file of the pilot (docs/factory.md). One check: README.md has the pilot's line.
[limits]
idle = \"15m\"
total = \"1h\"

[[checks]]
name = \"readme\"
command = \"grep -q 'Hello from the factory pilot.' README.md\"
TOML
git add .solidtrace/factory.toml && git commit -q -m 'Add the factory file' && git push -q && rm -rf \"\$d\""
  printf '\n'
  open_url "https://bitbucket.org/$BB_WORKSPACE/$BB_REPO/admin/branch-restrictions"
  step "Add a restriction for the branch main: Write access and Merge via pull request: only you."
  step "Then the factory's token cannot push to main or merge a PR."
  pause "Press Enter when it is saved."
  open_url "https://bitbucket.org/$BB_WORKSPACE/$BB_REPO/admin/access-tokens"
  note "If the page moved: Repository settings → Security → Access tokens."
  step "Create an access token, name solidtrace-factory, scopes Repositories: Write and Pull requests: Write."
  ask_secret BB_TOKEN "Paste the token (the wizard does not keep it):"
  [[ -n "$BB_TOKEN" ]] || { warn "The token is necessary."; exit 1; }
  bb_file="$SECRETS/bitbucket-token"
  printf '%s' "$BB_TOKEN" > "$bb_file"
  unset BB_TOKEN
  ask_default BB_CONNECTION "The name of the forge connection:" bitbucket-main
  remember BB_CONNECTION
  run_cmd "Give the token to the Dispatcher (it keeps it encrypted)" \
    "solidtrace connections set $BB_CONNECTION --kind bitbucket --dispatcher http://localhost:$LOCAL_PORT < $bb_file"
  rm -f "$bb_file"
  ask ST_PROJECT "The slug of the SolidTrace Project for the test repository (make one in Console first if you need):"
  remember ST_PROJECT
  run_cmd "Connect the Project to the repository" \
    "solidtrace projects set $ST_PROJECT --repository bitbucket.org/$BB_WORKSPACE/$BB_REPO --connection $BB_CONNECTION"
fi

# ── 17 ────────────────────────────────────────────────────────────────────
if begin "The first Run"; then
  need ST_PROJECT SOLIDTRACE_URL ORG_SLUG SERVER_SSH
  say "A small task that changes one line, so the Run shows each part: the checkout, the agent,"
  say "a check, the PR and the record in SolidTrace."
  note "The task names the factory's verbs: a Run from the CLI is not told about them yet."
  task="Add the line 'Hello from the factory pilot.' at the end of README.md, and commit it. Then run 'solidtrace check', open the PR with 'solidtrace pr', and end with 'solidtrace report --outcome done' and a short summary."
  run_cmd "Start the Run" "solidtrace start --project $ST_PROJECT \"$task\""
  open_url "$SOLIDTRACE_URL/$ORG_SLUG/runs"
  step "The Run goes from queued to running, then to done (a few minutes)."
  step "Its page shows the PR on Bitbucket, the check 'readme' passed, and the Agent session."
  step "If it stays queued, its page says why. The next two commands show the Dispatcher's log and Squid's log."
  run_cmd "The Dispatcher's log" "$SERVER_SSH 'cd /opt/solid-trace-factory && sudo docker compose logs --tail 40 dispatcher'"
  run_cmd "Squid's log: each host that the Run reached (TCP_DENIED is a refused host)" \
    "$SERVER_SSH sudo tail -n 30 /var/log/squid/access.log"
  pause "Press Enter when the PR is open."
fi

if [[ -f "$STATE_DIR/tunnel.pid" ]] && kill -0 "$(cat "$STATE_DIR/tunnel.pid")" 2>/dev/null; then
  if confirm "Close the IAP tunnel now?"; then
    kill "$(cat "$STATE_DIR/tunnel.pid")" 2>/dev/null || true
    rm -f "$STATE_DIR/tunnel.pid"
  fi
fi
SKIPPED+=("take-over: needs the OS Login group of the access group (factory/image/README.md)")
SKIPPED+=("not in this setup: webhooks (Caddy), more accounts, Spot VMs and autoscaling (docs/factory.md, Scaling)")
finish
note "Values: $ENV_FILE · scripts: $SCRIPTS"
