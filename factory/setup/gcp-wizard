# remember KEY... writes each value to the values file.
remember() { local k; for k; do write_env "$k" "${!k}"; done; }

# need KEY... stops when a value from an earlier stage is missing.
need() {
  local k
  for k; do
    [[ -n "${!k:-}" ]] || { warn "$k has no value. Run the stage that sets it (gcp-wizard --from N)."; exit 1; }
  done
}

# ask_default KEY "Prompt" DEFAULT is ask, with DEFAULT when there is no saved value.
ask_default() {
  local key="$1" prompt="$2" def="$3" input
  if _existing "$key" >/dev/null; then
    ask "$key" "$prompt"
    [[ -n "${!key}" ]] || printf -v "$key" '%s' "$def"
    return
  fi
  if [[ -n "$def" ]]; then
    printf '  %s%s%s %s[Enter: %s]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$def" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  printf -v "$key" '%s' "${input:-$def}"
}

# begin "Name" starts a stage, or returns 1 to skip it before --from.
begin() {
  if (( _STAGE_INDEX + 1 < FROM )); then
    _STAGE_INDEX=$((_STAGE_INDEX + 1))
    return 1
  fi
  stage "$1"
}

show_cmd() {
  printf '\n'
  printf '%s\n' "$1" | while IFS= read -r l; do printf '    %s%s%s\n' "$BOLD" "$l" "$RESET"; done
  printf '\n'
}

# show_script FILE prints a script that a command sends to a VM.
show_script() {
  printf '  %sThe script %s:%s\n' "$DIM" "$1" "$RESET"
  sed 's/^/    │ /' "$1"
}

CHOICE=""
choose() {
  local reply
  while :; do
    printf '  %s? [r] the wizard runs it · [m] I run it myself · [s] skip%s ' "$YELLOW" "$RESET"
    read -r reply || reply=s
    case "$reply" in
      [Rr]) CHOICE=r; return ;;
      [Mm]) CHOICE=m; return ;;
      [Ss]) CHOICE=s; return ;;
    esac
  done
}

# run_cmd "What it does" "command": shows the command, then runs it, waits for you, or skips.
run_cmd() {
  local what="$1" cmd="$2" rc
  printf '\n'; step "$what"
  show_cmd "$cmd"
  while :; do
    choose
    case "$CHOICE" in
      r)
        rc=0; bash -o pipefail -c "$cmd" || rc=$?
        if (( rc == 0 )); then printf '  %s✓ done%s\n' "$GREEN" "$RESET"; return 0; fi
        warn "the command failed (exit $rc)"
        if confirm "Try it again?"; then continue; fi
        if confirm "Go on to the next step?"; then SKIPPED+=("$what (failed, exit $rc)"); return 0; fi
        exit 1 ;;
      m)
        note "Copy the command, run it in another terminal, and read its output."
        pause "Press Enter when it is done."
        return 0 ;;
      s)
        SKIPPED+=("$what")
        return 0 ;;
    esac
  done
}

# run_capture KEY "What it does" "command" [secret]: the command's output becomes KEY.
run_capture() {
  local key="$1" what="$2" cmd="$3" secret="${4:-}" out rc
  printf '\n'; step "$what"
  show_cmd "$cmd"
  while :; do
    choose
    case "$CHOICE" in
      r)
        rc=0; out="$(bash -o pipefail -c "$cmd")" || rc=$?
        out="$(printf '%s' "$out" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if (( rc == 0 )) && [[ -n "$out" && "$out" != *$'\n'* ]]; then
          printf -v "$key" '%s' "$out"
          if [[ -n "$secret" ]]; then printf '  %s✓%s %s (hidden)\n' "$GREEN" "$RESET" "$key"
          else printf '  %s✓%s %s = %s\n' "$GREEN" "$RESET" "$key" "$out"; fi
          return 0
        fi
        warn "the command failed (exit $rc), or did not give one line"
        [[ -z "$secret" && -n "$out" ]] && note "$out"
        if confirm "Try it again?"; then continue; fi ;;
      m) note "Run it in another terminal." ;;
      s) ;;
    esac
    if [[ -n "$secret" ]]; then ask_secret "$key" "Paste the value of $key:"
    else ask "$key" "Type or paste the value of $key:"; fi
    [[ -n "${!key}" ]] && return 0
    warn "$key needs a value"
  done
}

# new_script NAME KEY... < body: writes $SCRIPTS/NAME.sh, with the values first.
new_script() {
  local name="$1" k
  shift
  SCRIPT="$SCRIPTS/$name.sh"
  {
    printf '#!/usr/bin/env bash\n# Made by factory/setup/gcp-wizard. It runs as root on the VM.\nset -euo pipefail\n'
    for k; do printf '%s=%q\n' "$k" "${!k}"; done
    cat
  } > "$SCRIPT"
}

# embed DEST MODE < content: script text that writes content to DEST on the VM.
embed() {
  printf "install -D -m %s /dev/stdin %q <<'__FACTORY_FILE__'\n" "$2" "$1"
  cat
  printf '__FACTORY_FILE__\n'
}

# on_vm SSH SCRIPT: the command that copies SCRIPT to a VM and runs it there as root.
on_vm() {
  printf "%s 'f=\$(mktemp) && cat >\"\$f\" && sudo bash \"\$f\"; rc=\$?; rm -f \"\$f\"; exit \$rc' < %s" "$1" "$2"
}

# The host and port of a URL, with the scheme's port when it has none.
url_host() { local u="${1#*://}"; u="${u%%/*}"; printf '%s' "${u%%:*}"; }
url_port() {
  local u="${1#*://}"; u="${u%%/*}"
  if [[ "$u" == *:* ]]; then printf '%s' "${u##*:}"
  elif [[ "$1" == https://* ]]; then printf 443
  else printf 80; fi
}

# fw NAME ARGS...: make a firewall rule when it is not there.
fw() {
  local name="$1"; shift
  printf 'gcloud compute firewall-rules describe %s --project %s >/dev/null 2>&1 ||\n  gcloud compute firewall-rules create %s --project %s --network %s \\\n    %s' \
    "$name" "$PROJECT" "$name" "$PROJECT" "$SOLIDTRACE_NETWORK" "$*"
}

