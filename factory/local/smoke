  docker exec "$machine" mkdir -p /opt/factory-checks
  docker cp "$bin/wrapper.test" "$machine:/opt/factory-checks/wrapper.test" >/dev/null
  rm -rf "$bin"
  docker exec "$machine" chown root:root /opt/factory-checks/wrapper.test
  docker exec "$machine" chmod 0755 /opt/factory-checks/wrapper.test
}

