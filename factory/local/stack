#!/usr/bin/env bash
# Starts and stops the local factory stack (factory/local/README.md).
#
#   factory/local/stack up            build the images, start the stack, wait until the agent machine is a ready Nomad client
#   factory/local/stack down          stop the stack and delete its containers and volumes
#   factory/local/stack clean         the same, and delete its images (about 1 GB)
#   factory/local/stack nomad <args>  run the Nomad CLI on the server, with the management token
#   factory/local/stack shell [user]  a shell on the agent machine (default user: root)
#
# The compose project is factory-local. It has its own containers, networks and volumes,
# and publishes no port on the host. It never touches the dev SolidTrace's containers.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# "-p" first: COMPOSE_PROJECT_NAME in the environment comes before the file's "name".
compose() { docker compose -p factory-local -f "$here/compose.yml" "$@"; }
token_file=/nomad/data/management-token

# Bootstraps Nomad's ACLs one time, and prints the management token.
management_token() {
  compose exec -T nomad sh -c </dev/null "
    if [ ! -s $token_file ]; then
      nomad acl bootstrap -json | sed -n 's/.*\"SecretID\": *\"\\([^\"]*\\)\".*/\\1/p' >$token_file.new
      [ -s $token_file.new ] && mv $token_file.new $token_file && chmod 600 $token_file
    fi
    cat $token_file"
}

nomad() {
  local token
  token="$(management_token)"
  compose exec -T -e NOMAD_TOKEN="$token" nomad nomad "$@"
}

# Makes a Nomad introduction token for the agent machine's client (nomad/server.hcl),
# and puts it in the client's state directory, which only root can read.
introduce_client() {
  local jwt
  jwt="$(nomad node intro create -node-name agent-machine-1 -ttl 10m -t '{{.JWT}}' </dev/null)"
  [ -n "$jwt" ] || { echo "stack: no Nomad introduction token" >&2; return 1; }
  compose exec -T agent-machine sh -c 'umask 077 && mkdir -p /var/lib/nomad/client &&
    cat >/var/lib/nomad/client/intro_token.jwt.new && mv /var/lib/nomad/client/intro_token.jwt.new /var/lib/nomad/client/intro_token.jwt' <<<"$jwt"
}

wait_for_client() {
  for _ in $(seq 1 60); do
    if nomad node status 2>/dev/null | awk 'NR > 1 && $NF == "ready" { found = 1 } END { exit !found }'; then
      return 0
    fi
    sleep 2
  done
  echo "stack: the agent machine did not become a ready Nomad client in 120 seconds" >&2
  compose logs --tail 40 agent-machine >&2
  return 1
}

case "${1:-}" in
up)
  compose build --quiet
  compose up --detach --wait --quiet-pull
  management_token >/dev/null
  introduce_client
  wait_for_client
  echo "stack: up (compose project factory-local)"
  ;;
down)
  compose down --volumes --remove-orphans --timeout 5
  ;;
clean)
  compose down --volumes --remove-orphans --timeout 5 --rmi all
  ;;
nomad)
  shift
  nomad "$@"
  ;;
shell)
  docker exec -it -u "${2:-root}" -w / "$(compose ps -q agent-machine)" bash -l
  ;;
*)
  sed -n '2,11p' "$0" >&2
  exit 2
  ;;
esac
