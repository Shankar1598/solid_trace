# The Dispatcher's operator configuration (docs/factory.md). Copy this file to
# /etc/solid-trace-factory/dispatcher.env, owned by root with mode 600: it holds secrets.
# Compose reads it as NAME=value lines with no quotes and no "export". The Dispatcher reads
# the same names from the environment, or from a file that DISPATCHER_CONFIG names, with the
# environment first. Each name here is one that the Dispatcher knows; a name that is not set
# has its default.

# --- Necessary ---

# SolidTrace's URL, as the server VM reaches it, and the Dispatcher's API token (Settings ->
# API tokens, "The Dispatcher's token", made by an Admin of the Organization).
DISPATCHER_SOLIDTRACE_URL=https://solidtrace.example.com
DISPATCHER_SOLIDTRACE_TOKEN=

# The key that encrypts the secrets in the database. Make it one time with
# "openssl rand -base64 32" and keep a copy: with another key, the Dispatcher does not start.
DISPATCHER_ENCRYPTION_KEY=

# The private listener serves the API. Set it to the server VM's private address, never to
# a public address or to 0.0.0.0. The default is 127.0.0.1:7600, which no agent VM reaches.
DISPATCHER_LISTEN=10.100.0.3:7600

# --- Nomad: with no address, no Run starts (each stays queued) ---

# Nomad's HTTP API on the server VM, the token of dispatcher-policy.hcl, and the machine
# kinds as name=memory in MB (the name is a Nomad node pool; the first is the default kind).
DISPATCHER_NOMAD_ADDR=http://10.100.0.3:4646
DISPATCHER_NOMAD_TOKEN=
DISPATCHER_MACHINE_KINDS=standard=12288

# How a wrapper on an agent VM reaches the Dispatcher: the private listener, from the agent
# VM's side.
DISPATCHER_WRAPPER_URL=http://10.100.0.3:7600

# --- Squid ---

# The allowlist file that Squid reads. The Dispatcher writes the default list, plus
# SolidTrace's hosts, plus the extra hosts of the repositories that Projects name.
# systemd reloads Squid when it changes, so the reload command does nothing.
DISPATCHER_SQUID_ALLOWLIST=/etc/squid/factory/allowlist.txt
DISPATCHER_DEFAULT_ALLOWLIST=/etc/solid-trace-factory/default-allowlist.txt
DISPATCHER_SQUID_RELOAD=true

# --- Webhooks: with no listener, a tracker or a forge cannot send webhooks ---

# Caddy sends /webhooks/* from the public name to this address (factory/reference/caddy).
DISPATCHER_WEBHOOK_LISTEN=127.0.0.1:7601
DISPATCHER_WEBHOOK_URL=https://factory.example.com

# --- Optional ---

# DISPATCHER_SOLIDTRACE_INGEST_URL=      where the wrappers upload; the default is SolidTrace's URL
# DISPATCHER_TRIGGER_WORD=/agent         one word, no spaces
# DISPATCHER_SCHEDULE_MIN_INTERVAL=1h    the shortest time between two fire times of a schedule
# DISPATCHER_DEFAULT_MACHINE_KIND=       the kind that a repository with no kind in its factory file gets
# DISPATCHER_NOMAD_NAMESPACE=            the default namespace
# DISPATCHER_SENDER_STARTS_PER_MINUTE=10
# DISPATCHER_SENDER_ACTIVE_RUNS=5
# DISPATCHER_WIP_REFS=refs/agent-wip     or refs/heads/agent-wip, for a forge that refuses refs outside refs/heads
