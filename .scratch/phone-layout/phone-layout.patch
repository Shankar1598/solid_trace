@@ -0,0 +1,38 @@
+import { useEffect, useState } from 'react'
+import { Dialog } from '@base-ui/react/dialog'
+import { router, usePage } from '@inertiajs/react'
+import { Menu, X } from 'lucide-react'
+import { buttonVariants } from '@/components/ui/button'
+import type { SharedProps } from '@/types'
+import { Sidebar } from './Sidebar'
+
+/**
+ * Below md the sidebar is hidden: a bar names the Organization, and its
+ * button opens the sidebar as a drawer, which closes on the next visit.
+ */
+export function PhoneNav() {
+  const { current_org } = usePage<SharedProps>().props
+  const [open, setOpen] = useState(false)
+  useEffect(() => router.on('navigate', () => setOpen(false)), [])
+  if (!current_org) return null
+
+  return (
+    <Dialog.Root open={open} onOpenChange={setOpen}>
+      <div className="flex h-12 shrink-0 items-center gap-2 border-b px-2 md:hidden">
+        <Dialog.Trigger className={buttonVariants({ variant: 'ghost', size: 'icon' })} aria-label="Open the menu">
+          <Menu />
+        </Dialog.Trigger>
+        <span className="truncate text-sm font-semibold">{current_org.name}</span>
+      </div>
+      <Dialog.Portal>
+        <Dialog.Backdrop className="fixed inset-0 z-40 bg-black/50" />
+        <Dialog.Popup aria-label="Menu" className="fixed inset-y-0 left-0 z-50 flex w-64 max-w-[85vw] outline-none">
+          <Sidebar className="flex w-full" />
+          <Dialog.Close className={buttonVariants({ variant: 'ghost', size: 'icon-sm', className: 'absolute right-2 top-3.5' })} aria-label="Close the menu">
+            <X />
+          </Dialog.Close>
+        </Dialog.Popup>
+      </Dialog.Portal>
+    </Dialog.Root>
+  )
+}
