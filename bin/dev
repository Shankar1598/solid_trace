#!/usr/bin/env sh

if ! gem list foreman -i --silent; then
  echo "Installing foreman..."
  gem install foreman
fi
# if ! gem list overmind -i --silent; then
#   echo "Installing overmind..."
#   gem install overmind
# fi

# Default to port 3000 if not specified
export PORT="${PORT:-3000}"

# Let the debug gem allow remote connections,
# but avoid loading until `debugger` is called
export RUBY_DEBUG_OPEN="true"
export RUBY_DEBUG_LAZY="true"

source "$(dirname "$0")/clear-ports"

# ClickHouse and MinIO (docker-compose.dev.yml) before the rest, so a failure
# stops here rather than taking the stack down from inside foreman.
"$(dirname "$0")/clickhouse-dev" || exit 1

exec foreman start -f Procfile.dev "$@"
