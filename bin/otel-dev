#!/usr/bin/env bash
# Sends Logs and Metric data points to EventStore through an OpenTelemetry Collector, as a
# real deployment does. The script starts the `otel` profile of
# docker-compose.dev.yml (local/otel/collector.yaml, with telemetrygen). It
# sends <count> Logs and <count> Metric data points through the Collector, and
# waits until the Collector has sent them all. It prints what the Collector
# sent, and it stops the containers that it started.
#
#   bin/otel-dev <count> [ingest-url] [key]
#
# The Collector sends each Log and each data point twice: once as protobuf with
# gzip, and once as plain JSON. So <count> Logs become 2 x <count> stored Logs,
# with service telemetrygen and environment dev. The <count> data points are
# half a Sum (otel_dev.sum) and half a Gauge (otel_dev.gauge), and the Sum has
# the extra one when <count> is odd. Each data point is stored as one Log, so
# they make 2 x <count> more Logs, with the metric name as the message. The
# Gauge is left out when <count> is 1. Without an ingest-url and a key, the Logs
# go to the dev stack (http://127.0.0.1:4000) with the seed Project's key,
# testkey123. For a verify stack, pass its ingest URL, for example
# http://127.0.0.1:4510.
#
# OTEL_DEV_LOG=<file> saves the Collector's log there, for proof.
#
# The Collector listens on 127.0.0.1:14318 (OTLP/HTTP) and :14888 (its own
# metrics). Run one bin/otel-dev at a time. It never touches ClickHouse or
# MinIO.

set -euo pipefail

usage="usage: bin/otel-dev <count> [ingest-url] [key]"
if [[ $# -lt 1 || $# -gt 3 || ! ${1:-} =~ ^[1-9][0-9]*$ ]]; then
  echo "$usage" >&2
  exit 2
fi
count=$1
# The Collector runs on the host's network. Use 127.0.0.1, because localhost
# can resolve to ::1 while EventStore listens on IPv4 only.
ingest_url=${2:-http://127.0.0.1:4000}
ingest_url=${ingest_url/\/\/localhost/\/\/127.0.0.1}
ingest_url=${ingest_url%/}
key=${3:-testkey123}

checkout="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
collector=solidtrace-otel-collector
generator=solidtrace-otel-telemetrygen
metrics_generator=solidtrace-otel-telemetrygen-metrics
collector_metrics=http://127.0.0.1:14888/metrics
gauge_count=$((count / 2))
sum_count=$((count - gauge_count))

# Compose needs these three variables for the dev ClickHouse, which this
# profile does not start. The dummy values only let Compose read the file.
# An exported variable wins over .env.
export SOLIDTRACE_DEV_UID=${SOLIDTRACE_DEV_UID:-$(id -u)}
export SOLIDTRACE_DEV_GID=${SOLIDTRACE_DEV_GID:-$(id -g)}
export SOLIDTRACE_DEV_STORAGE=${SOLIDTRACE_DEV_STORAGE:-$checkout/storage}
export SOLIDTRACE_INGEST_URL=$ingest_url
export SOLIDTRACE_KEY=$key
export OTEL_LOG_COUNT=$count
compose() { docker compose -f "$checkout/docker-compose.dev.yml" --profile otel "$@"; }

for name in "$collector" "$generator" "$metrics_generator"; do
  if docker inspect "$name" >/dev/null 2>&1; then
    echo "$name is running already, so another bin/otel-dev has the Collector's ports. Wait for it, or stop it: docker rm -f $name" >&2
    exit 1
  fi
done

# Stops what this run started, by name, also after an error or Ctrl-C.
# With OTEL_DEV_LOG=<file>, it saves the Collector's log first.
cleanup() {
  [[ -z ${OTEL_DEV_LOG:-} ]] || docker logs "$collector" >| "$OTEL_DEV_LOG" 2>&1 || true
  docker rm -f "$generator" "$metrics_generator" "$collector" >/dev/null 2>&1 || true
}
trap cleanup EXIT

# The Collector's counter of sent (or failed) Log records or Metric data
# points for one exporter: counter <sent|send_failed> <log_records|metric_points> <exporter>.
counter() {
  local name=$1 unit=$2 exporter=$3
  curl -fsS "$collector_metrics" 2>/dev/null |
    awk -v n="otelcol_exporter_${name}_${unit}" -v e="exporter=\"$exporter\"" \
      'index($0, n "{") == 1 && index($0, e) { total += $NF } END { printf "%d", total }'
}

echo "Starting the Collector (ingest $ingest_url)"
compose up --detach --no-deps --quiet-pull otel-collector >/dev/null
for _ in {1..60}; do
  curl -fsS -o /dev/null "$collector_metrics" 2>/dev/null && break
  sleep 0.5
done
if ! curl -fsS -o /dev/null "$collector_metrics" 2>/dev/null; then
  echo "The Collector did not start. See: docker logs $collector" >&2
  docker logs "$collector" 2>&1 | tail -20 >&2 || true
  exit 1
fi

echo "Sending $count Logs and $count Metric data points through the Collector"
compose run --rm --no-deps --name "$generator" telemetrygen >/dev/null 2>&1 ||
  { echo "telemetrygen failed. Run it by hand with docker compose to see why." >&2; exit 1; }
# One telemetrygen run sends one metric type. The Gauge run is left out when its count is 0.
send_metrics() {
  local type=$1 name=$2 n=$3
  (( n > 0 )) || return 0
  OTEL_METRIC_TYPE=$type OTEL_METRIC_NAME=$name OTEL_METRIC_COUNT=$n \
    compose run --rm --no-deps --name "$metrics_generator" telemetrygen-metrics >/dev/null 2>&1 ||
    { echo "telemetrygen metrics ($type) failed. Run it by hand with docker compose to see why." >&2; exit 1; }
}
send_metrics Sum sum "$sum_count"
send_metrics Gauge gauge "$gauge_count"

# The Collector holds data for up to a second, and an exporter can retry.
# Wait until each exporter has sent every Log and every Metric data point, or
# until one has failed.
protobuf=0 json=0 metrics_protobuf=0 metrics_json=0 failed=0
for _ in {1..120}; do
  protobuf=$(counter sent log_records otlp_http/protobuf)
  json=$(counter sent log_records otlp_http/json)
  metrics_protobuf=$(counter sent metric_points otlp_http/protobuf)
  metrics_json=$(counter sent metric_points otlp_http/json)
  failed=$(( $(counter send_failed log_records otlp_http/protobuf) + $(counter send_failed log_records otlp_http/json) \
    + $(counter send_failed metric_points otlp_http/protobuf) + $(counter send_failed metric_points otlp_http/json) ))
  (( failed > 0 || (protobuf >= count && json >= count && metrics_protobuf >= count && metrics_json >= count) )) && break
  sleep 0.5
done

errors=$(docker logs "$collector" 2>&1 | grep -i 'dropping data' || true)
if (( failed > 0 )) || [[ -n $errors ]] || (( protobuf < count || json < count || metrics_protobuf < count || metrics_json < count )); then
  echo "The Collector did not send everything (Logs: protobuf $protobuf, JSON $json; Metric data points: protobuf $metrics_protobuf, JSON $metrics_json; failed $failed; $count of each expected):" >&2
  echo "${errors:-no error in the Collector log}" | tail -20 >&2
  exit 1
fi

echo "Sent through the Collector to $ingest_url with key $key:"
echo "  Logs to /v1/logs:"
echo "    protobuf with gzip: $protobuf"
echo "    JSON, no gzip:      $json"
echo "  Metric data points to /v1/metrics ($sum_count Sum otel_dev.sum, $gauge_count Gauge otel_dev.gauge):"
echo "    protobuf with gzip: $metrics_protobuf"
echo "    JSON, no gzip:      $metrics_json"
echo "Expect $((protobuf + json)) Logs and $((metrics_protobuf + metrics_json)) Logs from data points, with service telemetrygen and environment dev, in the Logs explorer."
