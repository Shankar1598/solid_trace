#!/usr/bin/env bash

# Function to check and free a port
check_and_free_port() {
  local port=$1
  local apps=$2

  # Find PIDs using the port
  local pids=$(lsof -ti :$port)

  if [ -z "$pids" ]; then
    echo "✅ Port $port ($apps) is free."
  else
    echo "⚠️  Port $port ($apps) is in use by the following process(es):"
    lsof -i :$port
    echo ""

    read -p "Do you want to send SIGTERM to these processes? (y/N) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      echo "Killing PIDs: $pids"
      kill $pids
      echo "Done."
    else
      echo "Skipping..."
    fi
  fi
  echo "---------------------------------------------------"
}

# Function to check and delete a file
check_and_delete_file() {
  local file_path=$1

  if [ -f "$file_path" ]; then
    echo "⚠️  File $file_path exists."
    read -p "Do you want to delete it? (y/N) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      rm "$file_path"
      echo "Deleted $file_path."
    else
      echo "Skipping..."
    fi
  else
    echo "✅ File $file_path does not exist."
  fi
  echo "---------------------------------------------------"
}

echo "Checking for processes on ports 3000 and 4000..."
echo "---------------------------------------------------"

check_and_free_port 3000 "Rails Console"
check_and_free_port 4000 "EventStore"
if [[ "$1" == "--locks" ]]; then
  check_and_delete_file "./storage/rocksdb/development/events/LOCK"
fi
