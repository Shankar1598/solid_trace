#!/usr/bin/env bash
# Starts the ClickHouse server and the MinIO that the dev stack and the Go
# tests share (docker-compose.dev.yml), if they aren't running, and waits
# until ClickHouse answers. bin/go-dev runs it.
#
#   bin/clickhouse-dev           # start them, or restart ClickHouse if deploy/clickhouse changed
#   bin/clickhouse-dev --stop    # stop and remove the containers; their data stays
#
# One compose project, solidtrace-dev, serves every checkout and worktree. Its
# data is in the main checkout's storage/ (clickhouse/, minio/), which
# outlives worktrees, with a copy of deploy/clickhouse/'s config taken from
# the checkout that last started it. ClickHouse listens on 127.0.0.1:4200
# (native) and :4201 (HTTP), and EventStore's user, solidtrace, has no
# password here. MinIO listens on 127.0.0.1:9000 (S3) and :9001 (console),
# with the key solidtrace / solidtrace-dev. Each Go test package makes and
# drops a database of its own on ClickHouse (pkg/clickhousetest).

set -euo pipefail

checkout="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
main="$(dirname "$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir)")"
dir="$main/storage/clickhouse"

export SOLIDTRACE_DEV_STORAGE="$main/storage"
export SOLIDTRACE_DEV_UID="$(id -u)" SOLIDTRACE_DEV_GID="$(id -g)"
compose() { docker compose -f "$checkout/docker-compose.dev.yml" "$@"; }

if [[ ${1:-} == --stop ]]; then
  compose down
  exit 0
fi

wait_until_up() {
  for _ in {1..60}; do
    curl -fsS -o /dev/null http://127.0.0.1:4201/ping 2>/dev/null && return
    sleep 0.5
  done
  echo "ClickHouse did not answer on 127.0.0.1:4201. See: docker logs solidtrace-clickhouse" >&2
  exit 1
}

# The config is copied, so the container doesn't depend on a worktree that
# may be removed. A changed config restarts it.
changed=0
for sub in config.d users.d; do
  if ! diff -rq "$checkout/deploy/clickhouse/$sub" "$dir/etc/$sub" >/dev/null 2>&1; then
    changed=1
  fi
done
if (( changed )); then
  mkdir -p "$dir/etc"
  rm -rf "$dir/etc/config.d" "$dir/etc/users.d"
  cp -R "$checkout/deploy/clickhouse/config.d" "$checkout/deploy/clickhouse/users.d" "$dir/etc/"
fi

mkdir -p "$dir/data" "$dir/conf.d" "$main/storage/minio" "$main/storage/duckdb/development/logs_parquet"
# Creates or recreates what's missing or changed (an image, the compose file).
compose up --detach --quiet-pull
if (( changed )); then
  echo "deploy/clickhouse changed: restarting ClickHouse"
  compose restart clickhouse
fi

wait_until_up
